					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">788c2288bf3e1ea10b09fff70000190e</UniqueId>
					<string name="Name">ZoneVisuals</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000519d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX36285D0118BD4EB1953694AAA4FAD13D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Config=require(game.ReplicatedStorage.Shared.PrototypeConfig)
local assets=game.ServerStorage.GameAssets
local Environment={}
local V,C=Vector3.new,CFrame.new
local function model(parent,name)
    local m=Instance.new("Model");m.Name=name;m.Parent=parent;return m
end
local function part(parent,name,size,cf,color,solid,material)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true
    p.CanCollide=solid==true;p.CanQuery=solid==true;p.CanTouch=false
    p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
    return p
end

function Environment.CreateSign(parent,name,cf,title,subtitle,color,width)
    local sign=model(parent,name);width=width or 30
    local frame=part(sign,"Neon frame",V(width+1.1,8.6,1.1),cf,color,false,Enum.Material.Neon)
    local body=part(sign,"Enamel panel",V(width,7.5,1.2),cf,Color3.fromRGB(30,60,80))
    sign.PrimaryPart=body
    for _,side in {-1,1}do
        part(sign,"Signpost",V(.8,cf.Position.Y-3,.9),C(cf.Position.X+side*(width*.39),(cf.Position.Y-3)/2,cf.Position.Z),Color3.fromRGB(69,99,111),true)
        part(sign,"Post collar",V(1.5,.7,1.5),C(cf.Position.X+side*(width*.39),1,cf.Position.Z),color)
    end
    for _,face in {Enum.NormalId.Front,Enum.NormalId.Back}do
        local gui=Instance.new("SurfaceGui");gui.Name="NeonLettering";gui.Face=face;gui.CanvasSize=Vector2.new(500,140);gui.LightInfluence=0;gui.Parent=body
        local main=Instance.new("TextLabel");main.Name="Title";main.BackgroundTransparency=1;main.Position=UDim2.fromScale(.03,.04);main.Size=UDim2.fromScale(.94,.66)
        main.Text=title;main.Font=Enum.Font.GothamBlack;main.TextScaled=true;main.TextColor3=Color3.fromRGB(221,255,255);main.TextStrokeColor3=color;main.TextStrokeTransparency=.1;main.Parent=gui
        local caption=main:Clone();caption.Name="Subtitle";caption.Position=UDim2.fromScale(.05,.75);caption.Size=UDim2.fromScale(.9,.17);caption.Text=subtitle;caption.TextColor3=color:Lerp(Color3.new(1,1,1),.6);caption.TextStrokeTransparency=1;caption.Parent=gui
    end
    local glow=Instance.new("PointLight");glow.Color=color;glow.Brightness=.5;glow.Range=22;glow.Parent=frame
    sign:SetAttribute("AssetId","Sign.NeonCampBoard")
    return sign
end

-- The authored sandstone mesh is reused for soft, faceted canyon silhouettes.
local function cliff(parent,name,cf,size,color,collision)
    local m=model(parent,name)
    local stretch=V(size.X/5.49,size.Y/3.68,size.Z/4.07)
    for _,source in assets.Ores.SandstoneOre:GetChildren()do
        if source:IsA("MeshPart") and source:GetAttribute("MeshRole")=="StoneBody" then
            local p=source:Clone();local localCF=source.CFrame
            p.Size=p.Size*stretch;p.CFrame=cf*C(localCF.Position*stretch)*localCF.Rotation
            local base=p:GetAttribute("BaseColor") or p.Color
            p.Color=color:Lerp(Color3.fromRGB(255,205,137),math.clamp((base.R-.65)*1.2,0,.26))
            p.Material=Enum.Material.SmoothPlastic;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Parent=m
        end
    end
    if collision then
        local p=part(m,"Cliff collision",V(size.X*.88,size.Y*.82,size.Z*.88),cf*C(0,size.Y*.4,0),color,true)
        p.Transparency=1
    end
    return m
end

-- Owned by CampEnvironment. Selective, repeatable wall-only migration.
function Environment.ReplaceRim(town)
    local kit=assets.Environment:FindFirstChild("CanyonMeshKit")
    assert(kit and kit:GetAttribute("AssetVersion")==3,"CanyonMeshKit v3 required")
    local rim=Instance.new("Model");rim.Name="Canyon rim"
    rim:SetAttribute("AssetId","Environment.LayeredCanyonRim")
    rim:SetAttribute("AssetVersion",3)
    rim:SetAttribute("InnerWallCenter",98)
    local count=0
    local function place(name,variant,position,size,yaw,solid,tint)
        local source=kit:FindFirstChild("CanyonWall_"..variant)
        assert(source and source.PrimaryPart,"Missing wall template "..variant)
        local m=Instance.new("Model");m.Name=name
        m:SetAttribute("AssetId",source:GetAttribute("AssetId") or "Environment.CanyonWall."..variant)
        m:SetAttribute("AssetVersion",3)
        m:SetAttribute("LayerRole",name)
        local p=source.PrimaryPart:Clone();p.Name="Sandstone visual"
        p.Size=size;p.PivotOffset=C(0,-size.Y/2,0)
        local cf=C(position)*CFrame.Angles(0,yaw,0)
        p.CFrame=cf*C(0,size.Y/2,0)
        p.Color=tint or Color3.new(1,1,1)
        p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
        p.Parent=m;m.PrimaryPart=p
        if solid then
            local collider=part(m,"Simple cliff collision",V(size.X*.95,size.Y*.95,size.Z*.70),cf*C(0,size.Y*.475,0),Color3.new(1,1,1),true)
            collider.Transparency=1
        end
        m.Parent=rim;count+=1
        return m
    end
    -- Close inner ring, with broad overlapping modules and varied skyline.
    local heights={38,43,35,40,37,44,39}
    for _,side in {-1,1}do
        for i=1,7 do
            local coordinate=-90+(i-1)*30
            local variant=(i+(side==1 and 1 or 0))%2==0 and "A" or "B"
            local yaw=side==1 and math.pi/2 or -math.pi/2
            local nudge=({0,1.1,-.8,.6,-1,.2,0})[i]
            place("Main side cliff",variant,V(side*(98+nudge),-.3,coordinate),V(35,heights[i],23),yaw+math.rad((i%3-1)*2),true)
        end
        task.wait()
    end
    for i=1,7 do
        local x=-90+(i-1)*30
        place("Arrival enclosing cliff",i%2==0 and "A" or "B",V(x,-.3,98+(i%3-1)),V(35,heights[8-i]-2,23),math.rad((i%3-1)*2),true)
        if i~=4 then
            place("Mine-side cliff",i%2==0 and "B" or "A",V(x,-.3,-98-(i%3-1)),V(35,heights[i]+1,24),math.pi+math.rad((i%3-1)*2),true)
        end
    end
    task.wait()
    -- Staggered rear masses rise above the close ring instead of making one flat wall.
    for _,side in {-1,1}do
        for i=1,5 do
            local c=-80+(i-1)*40
            local h=({24,30,23,28,25})[i]+(side==1 and 1 or -1)
            place("Rear ridge lower mass","Corner",V(side*117,-.3,c),V(49,28,29),side*math.pi/2+math.rad((i%3-1)*5),false)
            place("Rear high ridge",i%2==0 and "A" or "B",V(side*117,23,c),V(49,h,29),side*math.pi/2+math.rad((i%3-1)*5),false,Color3.fromRGB(248,245,241))
            if side==1 then
                place("Rear arrival lower mass","Corner",V(c,-.3,117),V(49,28,29),math.rad((i%3-1)*4),false)
                place("Rear arrival ridge",i%2==0 and "B" or "A",V(c,23,117),V(49,h-3,29),math.rad((i%3-1)*4),false,Color3.fromRGB(248,245,241))
            end
            if math.abs(c)>=40 and side==1 then
                place("Rear mine lower mass","Corner",V(c,-.3,-118),V(48,28,30),math.pi+math.rad((i%3-1)*4),false)
                place("Rear mine ridge",i%2==0 and "A" or "B",V(c,23,-118),V(48,h+2,30),math.pi+math.rad((i%3-1)*4),false,Color3.fromRGB(248,245,241))
            end
        end
        task.wait()
    end
    -- Four inward shoulders establish foreground / middle / high-back layers.
    for _,sx in {-1,1}do for _,sz in {-1,1}do
        place("Inset corner shoulder","Corner",V(sx*77,-.25,sz*72),V(36,24+(sx==sz and 3 or 0),32),sx*sz*.26,true)
        place("Corner upper ledge","A",V(sx*85,15,sz*85),V(32,24,26),sx*sz*.18,false)
    end end
    -- Keep the existing 26-stud gate and all three rooms exactly where they are.
    for _,side in {-1,1}do
        place("Portal shoulder","Corner",V(side*23,-.3,-85),V(14,27,24),math.pi+side*.08,true)
    end
    place("Portal crown","A",V(0,16,-94),V(46,27,29),math.pi,false)
    for _,side in {-1,1}do
        place("Portal upper transition","Corner",V(side*21,27,-109),V(28,20,26),math.pi+side*.12,false)
    end
    local crown=part(rim,"Portal overhead collision",V(31,24,25),C(0,28,-94),Color3.new(1,1,1),true);crown.Transparency=1
    rim:SetAttribute("VisualMeshCount",count)
    rim.WorldPivot=C(0,0,0)
    local old=town:FindFirstChild("Canyon rim")
    rim.Parent=town
    if old then old:Destroy()end
    town:SetAttribute("CanyonArtVersion",3)
    return rim
end

function Environment.Build(town)
    local floor=part(town,"Desert floor",V(196,2,196),C(0,-1,0),Color3.fromRGB(239,197,126),true,Enum.Material.Sand)
    part(town,"Mine foundation",V(40,2,120),C(0,-1,-133),Color3.fromRGB(239,197,126),true,Enum.Material.Sand)
    town.PrimaryPart=floor
    local paving=model(town,"Cross stone paving")
    local border=Color3.fromRGB(107,135,139)
    part(paving,"North south road foundation",V(27,.35,147),C(0,.03,0),border,true)
    part(paving,"East west road foundation",V(147,.35,27),C(0,.03,0),border,true)
    for row=-14,14 do
        for col=-14,14 do
            if math.abs(row)<=2 or math.abs(col)<=2 then
                local coveredByPractice = false
                for _, training in Config.Trainings do
                    local position = training.Position
                    if math.abs(col*5-position.X)+2.42<=12.5 and math.abs(row*5-position.Z)+2.42<=12.5 then
                        coveredByPractice = true
                        break
                    end
                end
                if coveredByPractice then continue end
                local variation=(row*7+col*11)%4
                part(paving,"Cross paving brick",V(4.84,.17,4.84),C(col*5,.28,row*5),Color3.fromRGB(193+variation*5,190+variation*5,169+variation*5),true)
            end
        end
        if row%5==0 then task.wait()end
    end
    for _,sx in {-1,1}do for _,sz in {-1,1}do
        part(paving,"Corner stall apron",V(25,.3,25),C(sx*27,.08,sz*27),Color3.fromRGB(180,178,157),true)
        part(paving,"Apron inset",V(23.5,.15,23.5),C(sx*27,.31,sz*27),Color3.fromRGB(214,203,174),true)
    end end
    part(paving,"Practice approach",V(10,.25,90),C(-42,.14,0),Color3.fromRGB(205,192,161),true)
    part(paving,"Rankings terrace",V(44,.55,51),C(58,.15,0),Color3.fromRGB(180,181,159),true)
    part(paving,"Rankings terrace inset",V(42,.12,49),C(58,.49,0),Color3.fromRGB(226,213,174),true)
    if assets:FindFirstChild('Environment') and assets.Environment:FindFirstChild('CanyonMeshKit') and assets.Environment.CanyonMeshKit:GetAttribute('AssetVersion')==3 then
        Environment.ReplaceRim(town)
    else
    local rim=model(town,"Canyon rim")
    local orange=Color3.fromRGB(196,127,80)
    for _,side in {-1,1}do
        for i=0,10 do
            local coordinate=-75+i*15
            cliff(rim,"Side canyon",C(side*85,0,coordinate),V(24,27+(i%3)*4,20),orange,true)
            if side==1 then
            cliff(rim,"South canyon",C(coordinate,0,85),V(20,26+(i%4)*3,25),orange,true)
            if math.abs(coordinate)>=30 then
                cliff(rim,"North canyon",C(coordinate,0,-85),V(20,30+(i%3)*3,25),orange,true)
            end
            end
        end
        task.wait()
    end
    for _,sx in {-1,1}do for _,sz in {-1,1}do
        cliff(rim,"Inset corner buttress",C(sx*62,0,sz*61)*CFrame.Angles(0,sx*sz*.16,0),V(48,18,38),orange,true)
        cliff(rim,"Corner upper ledge",C(sx*67,11,sz*68),V(35,18,30),Color3.fromRGB(215,150,91),false)
        task.wait()
    end end
    -- The fourth side is enclosed above the one playable mine doorway.
    for _,side in {-1,1}do
        cliff(rim,"Mine portal shoulder",C(side*22,0,-82),V(14,21,23),orange,true)
    end
    cliff(rim,"Mine arch crown",C(0,15,-85),V(42,18,25),orange,false)
    part(rim,"Mine arch collision",V(35,15,16),C(0,23,-85),orange,true).Transparency=1
    end
    Environment.CreateSign(town,"Practice neon billboard",C(-60,25,-48),"练功区","挥镐变强  ·  挑战更深矿脉",Color3.fromRGB(47,222,246),33)
    return floor
end

return Environment

]]></ProtectedString>
					<string name="ScriptGuid">{456EE12D-2D3A-4342-A347-4C7CC73B43DC}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">788c2288bf3e1ea10b09fff70000519f</UniqueId>
					<string name="Name">CampEnvironment</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff7000060d9</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXD8AEE1E914BD43F59A192B6822A10227">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.Shared.PrototypeConfig)
local Visuals = require(script.Parent.ZoneVisuals)
local Factory = require(script.Parent.MerchantAssets)
local assets = game.ServerStorage.GameAssets
local MiningAssets = require(script.Parent.MiningAssets)
local Environment = require(script.Parent.CampEnvironment)
local Builder = {}
local V, C = Vector3.new, CFrame.new
local sand = Color3.fromRGB(218,177,119)
local rock = Color3.fromRGB(178,117,77)
local slate = Color3.fromRGB(99,105,105)
local cream = Color3.fromRGB(255,239,194)

local function model(parent,name)
    local m=Instance.new("Model")
    m.Name=name
    m.Parent=parent
    return m
end
local function part(parent,name,size,cf,color,solid,material)
    local p=Instance.new("Part")
    p.Name=name
    p.Size=size
    p.CFrame=cf
    p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true
    p.CanCollide=solid==true
    p.CanTouch=false
    p.CanQuery=solid==true
    p.TopSurface=Enum.SurfaceType.Smooth
    p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
local function label(parent,name,cf,size,caption,color)
    local anchor=part(parent,name,V(.1,.1,.1),cf,cream)
    anchor.Transparency=1
    anchor.CanQuery=false
    local gui=Instance.new("BillboardGui")
    gui.Name="Lettering"
    gui.Size=UDim2.fromScale(size.X,size.Y)
    gui.MaxDistance=100
    gui.LightInfluence=0
    gui.Parent=anchor
    local text=Instance.new("TextLabel")
    text.Name="Title"
    text.Size=UDim2.fromScale(1,1)
    text.BackgroundTransparency=1
    text.Font=Enum.Font.GothamBold
    text.TextScaled=true
    text.Text=caption
    text.TextColor3=color or cream
    text.TextStrokeColor3=Color3.fromRGB(54,45,37)
    text.TextStrokeTransparency=.15
    text.Parent=gui
    return text
end
local function lamp(parent,x,z)
    part(parent,"Lantern foot",V(1,.3,1),C(x,.15,z),slate,true)
    part(parent,"Lantern post",V(.32,2.2,.32),C(x,1.4,z),slate,true)
    local glass=part(parent,"Warm lamp",V(.65,.8,.65),C(x,2.7,z),cream,false,Enum.Material.Neon)
    part(parent,"Lantern cap",V(.9,.18,.9),C(x,3.2,z),slate)
    local light=Instance.new("PointLight")
    light.Color=Color3.fromRGB(255,210,134)
    light.Brightness=.7
    light.Range=12
    light.Parent=glass
end
local function ore(parent,name,pos,color,crystal)
    local m=model(parent,name)
    local main=part(m,"Target",V(4.8,3.8,4.2),C(pos+V(0,2.2,0)),color,true)
    m.PrimaryPart=main
    local index=tonumber(name:match("%d+")) or 1
    MiningAssets.ReplaceRock(m,index,name:find("TrainingRock")~=nil,color)
    return m,main
end
local function board(parent,x,title,color,kind)
    local m=model(parent,kind)
    local panel=part(m,"Board",V(10,12,.5),C(x,8,-10)*CFrame.Angles(0,-.16,0),color,true)
    local surface=Instance.new("SurfaceGui")
    surface.Name="Scores"
    surface.Face=Enum.NormalId.Back
    surface.CanvasSize=Vector2.new(540,660)
    surface.LightInfluence=0
    surface.Parent=panel
    local frame=Instance.new("Frame")
    frame.Size=UDim2.fromScale(1,1)
    frame.BackgroundColor3=Color3.fromRGB(38,57,60)
    frame.BorderSizePixel=8
    frame.BorderColor3=color
    frame.Parent=surface
    for i=0,6 do
        local t=Instance.new("TextLabel")
        t.Name=i==0 and "Title" or "Row"..i
        t.Position=UDim2.fromOffset(22,18+i*86)
        t.Size=UDim2.fromOffset(496,i==0 and 70 or 64)
        t.BackgroundTransparency=1
        t.TextColor3=i==0 and color or cream
        t.Font=Enum.Font.GothamBold
        t.TextScaled=true
        t.Text=i==0 and title or (i==1 and "等待矿工上榜" or "")
        t.Parent=frame
    end
    panel:SetAttribute("BoardStat",kind)
    panel:AddTag("CampLeaderboard")
    for _,dx in {-3.5,3.5}do part(m,"Board leg",V(.5,2,.6),C(x+dx,1.5,-10),slate,true)end
end

function Builder.Build()
    local existing=workspace:FindFirstChild("Gem Gulch")
    if existing and existing:GetAttribute("PrototypeVersion")==Config.Version then return existing end
    local town=model(nil,"Gem Gulch")
    town:SetAttribute("AssetId","World.CanyonTown")
    town:SetAttribute("PrototypeVersion",Config.Version)
    town.Parent=workspace
    Environment.Build(town)
    local spawn=Instance.new("SpawnLocation")
    spawn.Name="Arrival";spawn.Size=V(7,.2,6);spawn.CFrame=C(Config.Hub.Arrival)
    spawn.Anchored=true;spawn.Neutral=true;spawn.Transparency=1;spawn.CanCollide=false;spawn.Duration=0;spawn.Parent=town
    label(town,"Hub title",C(0,8,69),Vector2.new(22,2),"晶脉峡谷  ·  矿工休息站")
    local buyer=assets.Stations.OreBuyer:Clone();buyer.Name="OreBuyer"
    buyer:PivotTo(C(-27,.43,27)*CFrame.Angles(0,math.rad(135),0));buyer.Parent=town
    local shopCF=C(27,.43,27)*CFrame.Angles(0,math.rad(-135),0)
    local shop=Factory.CreateStall(town,"ToolShop",shopCF,{Title="镐子铺",Canopy=Color3.fromRGB(67,193,241),Accent=Color3.fromRGB(70,121,132)})
    Factory.AttachMerchant(shop)
    local upgrade=part(shop,"Upgrade",V(.2,.2,.2),shopCF*C(0,3.5,3),cream)
    upgrade.Transparency=1
    local prompt=Instance.new("ProximityPrompt")
    prompt.Name="Interact";prompt.ActionText="升级工具 · 16 金币";prompt.ObjectText="镐子铺";prompt.MaxActivationDistance=10;prompt.RequiresLineOfSight=false;prompt.Parent=upgrade
    Visuals.Create(shop,"ShopZone",shopCF*C(0,0,8),{Color=Color3.fromRGB(61,190,245)})
    for _,cfg in {{"OreIndex",-27,-27,45,"矿石图鉴 · 筹备中",Color3.fromRGB(255,185,74)},{"BackpackShop",27,-27,-45,"背包铺 · 筹备中",Color3.fromRGB(190,127,246)}}do
        local cf=C(cfg[2],.43,cfg[3])*CFrame.Angles(0,math.rad(cfg[4]),0)
        local stall=Factory.CreateStall(town,cfg[1],cf,{Title=cfg[5],Canopy=cfg[6],Accent=Color3.fromRGB(132,100,73)})
        Factory.AttachMerchant(stall)
    end
    local training=model(town,"Training")
    for i,cfg in Config.Trainings do
        local pos=cfg.Position
        part(training,"Practice platform",V(25,.35,25),C(pos+V(0,-.05,0)),Color3.fromRGB(145,155,153),true)
        local pad=Visuals.Create(training,"TrainingPad"..i,C(pos+V(0,.12,0)),{
            Scale=2.12,Color=cfg.Color,Tag="TrainingZone",Attributes={TrainingIndex=i,Gain=cfg.Gain,RequiredPower=cfg.Required},
        })
        local m,target=ore(training,"TrainingRock"..i,pos+V(0,.28,0),cfg.Color,i>1)
        target.CanQuery=true;m:SetAttribute("TrainingIndex",i)
        label(m,"Training label",C(pos+V(0,cfg.Height+2.8,0)),Vector2.new(19,3),cfg.Name.."\n+"..cfg.Gain.." 力量 / 次"..(cfg.Required>0 and (" · 需 "..cfg.Required) or ""),cfg.Color:Lerp(Color3.new(1,1,1),.6))
    end
    local rankings=model(town,"Rankings")
    label(rankings,"Rank title",C(58,18,-10),Vector2.new(18,2),"矿工荣誉榜",Color3.fromRGB(255,209,110))
    board(rankings,49,"力量榜",Color3.fromRGB(255,198,84),"Power")
    board(rankings,66,"金币榜",Color3.fromRGB(93,221,156),"Coins")
    label(rankings,"Board scope",C(58,1.5,16),Vector2.new(16,1),"当前服务器")
    local mine=model(town,"Mine")
    label(mine,"Mine title",C(0,16,Config.Hub.MineFront+2),Vector2.new(22,2.4),"深入矿洞",cream)
    for _,x in {-13.5,13.5}do
        part(mine,"Entrance timber",V(1.2,13,1.3),C(x,6.5,Config.Hub.MineFront+2),Color3.fromRGB(113,76,48),true)
    end
    part(mine,"Entrance beam",V(29,1.2,1.5),C(0,13,Config.Hub.MineFront+2),Color3.fromRGB(139,96,59),true)
    for i,cfg in Config.Layers do
        local front=Config.Hub.MineFront-(i-1)*34
        local room=model(mine,"Layer"..i)
        room:SetAttribute("LayerIndex",i)
        room:SetAttribute("RareChance",cfg.RareChance)
        part(room,"Cave floor",V(28,.3,34),C(0,.1,front-17),Color3.fromRGB(134-i*9,126-i*8,108-i*6),true,Enum.Material.Slate)
        for _,side in {-1,1}do
            part(room,"Cave side",V(3,15,34),C(side*15,7.5,front-17),rock:Lerp(slate,.3+i*.1),true,Enum.Material.Sandstone)
            for j=0,2 do part(room,"Rock rib",V(2,12,3),C(side*13.8,6,front-7-j*10),Color3.fromRGB(125,102,83),true)end
        end
        part(room,"Cave ceiling",V(33,2,34),C(0,15,front-17),Color3.fromRGB(106,91,77),true,Enum.Material.Slate)
        local wall=part(room,"Gate",V(26,11,1.4),C(0,5.5,front),cfg.Color,true,Enum.Material.Sandstone)
        wall:SetAttribute("TargetKind","Gate")
        wall:SetAttribute("LayerIndex",i)
        wall:SetAttribute("MaxHealth",cfg.WallHealth)
        wall:AddTag("MineTarget")
        for j=-3,3 do part(room,"Gate seam",V(.055,10,.04),C(j*3.4,5.5,front+.72),cfg.Color:Lerp(Color3.new(0,0,0),.2))end
        label(room,"Gate label",C(0,11.8,front+1),Vector2.new(23,2.8),"第 "..i.." 层 · "..cfg.Name.."\n岩壁耐久 "..cfg.WallHealth.."  |  稀有矿 "..math.round(cfg.RareChance*100).."%",cream)
        for j=1,3 do
            local x=({-8,7,-6})[j]
            local z=front-9-(j-1)*8
            local m,target=ore(room,"OreNode"..j,V(x,.25,z),cfg.Color,true)
            target:SetAttribute("TargetKind","Ore")
            target:SetAttribute("LayerIndex",i)
            target:SetAttribute("MaxHealth",cfg.OreHealth)
            target:AddTag("MineTarget")
            for _,p in m:GetDescendants()do if p:IsA("BasePart")then p:SetAttribute("TargetRoot",target.Name)end end
            label(m,"Ore label",C(x,6.5,z),Vector2.new(9,1.3),"矿脉 · "..cfg.OreHealth.." 耐久")
        end
        for _,x in {-11,11}do lamp(room,x,front-13)end
    end
    part(mine,"Deep rock end",V(30,15,3),C(0,7.5,Config.Hub.MineFront-103),slate,true,Enum.Material.Slate)
    label(mine,"Demo end",C(0,5,Config.Hub.MineFront-98),Vector2.new(20,2),"已到达本次勘探终点")
    for _,p in {{-15,58},{15,58},{-15,-58},{15,-58},{-37,13},{-37,-13},{38,13},{38,-13}}do lamp(town,p[1],p[2])end
    if existing then existing:Destroy()end
    return town
end

return Builder
]]></ProtectedString>
					<string name="ScriptGuid">{46A492FE-3AD1-40B6-9B2E-B97E882492CE}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">788c2288bf3e1ea10b09fff70000190f</UniqueId>
					<string name="Name">WorldBuilder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff7000060db</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4309C246B64F4DD39F3E90041AC7FF06">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.Shared.PrototypeConfig)
local Balance = require(game.ReplicatedStorage.Shared.GameBalance)
local Big = require(game.ReplicatedStorage.Shared.BigInteger)
local Visuals = require(script.Parent.ZoneVisuals)
local Factory = require(script.Parent.MiningAssets)
local World = {}
local function part(parent,name,size,cf,color,solid)
    local p=Instance.new("Part")
    p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Anchored=true
    p.CanCollide=solid==true;p.CanTouch=false;p.CanQuery=solid==true
    p.Material=Enum.Material.SmoothPlastic;p.Parent=parent
    return p
end
local function label(parent,name,position,text)
    local anchor=part(parent,name,Vector3.new(.1,.1,.1),CFrame.new(position),Color3.new(1,1,1))
    anchor.Transparency=1
    local gui=Instance.new("BillboardGui")
    gui.Name="Lettering";gui.Size=name:match("^Name") and UDim2.fromScale(9,2.8) or UDim2.fromScale(16,3.1);gui.MaxDistance=95;gui.LightInfluence=0;gui.Parent=anchor
    local title=Instance.new("TextLabel")
    title.Name="Title";title.Size=UDim2.fromScale(1,1);title.BackgroundTransparency=1
    title.Font=Enum.Font.FredokaOne;title.TextScaled=true;title.TextColor3=Color3.fromRGB(255,242,207)
    title.TextStrokeColor3=Color3.fromRGB(35,41,48);title.TextStrokeTransparency=.1;title.Text=text;title.Parent=gui
    return anchor
end
function World.Build(camp)
    if camp:GetAttribute("CoreWorldVersion")==1 then return camp end
    local oldMine=camp:FindFirstChild("Mine")
    assert(oldMine and oldMine:FindFirstChild("Layer1"),"Missing mine template")
    local roomTemplate=oldMine.Layer1:Clone()
    local origin=roomTemplate.Gate.Position
    local newMine=Instance.new("Model");newMine.Name="Mine"
    for i=1,10 do
        local room=roomTemplate:Clone();room.Name="Layer"..i
        local delta=Vector3.new(0,0,-(i-1)*34)
        for _,o in room:GetDescendants() do
            if o:IsA("BasePart") then o.CFrame+=delta end
        end
        for _,child in room:GetChildren() do
            if child.Name:match("^OreNode") then child:Destroy() end
        end
        local gate=room.Gate
        gate:SetAttribute("LayerIndex",i);gate:SetAttribute("MaxHealth",Balance.Routes[1].Walls[i])
        gate:SetAttribute("TargetKind","Gate");gate:AddTag("MineTarget")
        room:SetAttribute("LayerIndex",i)
        room["Gate label"].Lettering.Title.Text="第 "..i.." 层\n岩壁 "..Big.Format(Balance.Routes[1].Walls[i])
        local lettering=room["Gate label"].Lettering
        lettering.Title.Size=UDim2.fromScale(1,.72)
        local track=Instance.new("Frame");track.Name="HealthTrack";track.Position=UDim2.fromScale(.1,.78)
        track.Size=UDim2.fromScale(.8,.12);track.BackgroundColor3=Color3.fromRGB(36,41,48);track.BorderSizePixel=0;track.Parent=lettering
        local fill=Instance.new("Frame");fill.Name="Fill";fill.Size=UDim2.fromScale(1,1)
        fill.BorderSizePixel=0;fill.BackgroundColor3=Color3.fromRGB(255,199,80);fill.Parent=track
        room.Parent=newMine
        task.wait()
    end
    roomTemplate:Destroy()
    oldMine:Destroy()
    newMine.Parent=camp
    part(newMine,"FinalBoundary",Vector3.new(32,17,3),CFrame.new(origin+Vector3.new(0,3,-340)),Color3.fromRGB(91,91,104),true)
    label(newMine,"FinalSign",origin+Vector3.new(0,3,-332),"本矿道勘探完成 · 返回出售")
    local selections=Instance.new("Folder");selections.Name="MineEntrances";selections.Parent=camp
    for i,route in Balance.Routes do
        local pos=Vector3.new((i-3)*10,2,-56)
        local panel=part(selections,"Entrance"..i,Vector3.new(8,4,.5),CFrame.new(pos),Color3.fromHex(route.Hex),true)
        panel:SetAttribute("RouteIndex",i)
        label(selections,"Name"..i,pos+Vector3.new(0,3,0),route.Label.."矿道\n"..(route.Required==0 and "直接进入" or "重生 "..route.Required.." 次"))
        local prompt=Instance.new("ProximityPrompt")
        prompt.Name="ChooseMine";prompt.ActionText="选择矿道";prompt.ObjectText=route.Name
        prompt.MaxActivationDistance=11;prompt.RequiresLineOfSight=false;prompt.Parent=panel
    end
    if camp:FindFirstChild("Training") then camp.Training:Destroy() end
    local training=Instance.new("Model");training.Name="Training";training.Parent=camp
    for i,area in Balance.Trainings do
        local column=(i-1)%2;local row=math.floor((i-1)/2)
        local pos=Vector3.new(-68+column*21,.65,38-row*29)
        local profile=Config.Trainings[(i-1)%3+1]
        local holder=Instance.new("Model");holder.Name="TrainingRock"..i;holder:SetAttribute("TrainingIndex",i)
        holder.Parent=training
        local visual=Factory.CreateTrainingRockVisual(holder,CFrame.new(pos)*CFrame.Angles(0,-math.pi/2,0),{
            PracticeAsset=profile.PracticeAsset,PracticeScale=.85})
        local bounds,size=visual:GetBoundingBox()
        local target=part(holder,"Target",size,bounds,profile.Color,false)
        target.Transparency=1;target.CanQuery=true;target:SetAttribute("TargetKind","Training")
        target:SetAttribute("TrainingIndex",i);target:SetAttribute("ImpactColor",profile.Color);target:SetAttribute("LargeImpact",true)
        target:AddTag("TrainingTarget")
        local collider=part(holder,"Collider",Vector3.new(size.X*.70,size.Y*.80,size.Z*.70),bounds,profile.Color,true)
        collider.Transparency=1
        local zone=Visuals.Create(training,"TrainingPad"..i,CFrame.new(pos+Vector3.new(0,-.15,0)),{
            Scale=1.4,Color=profile.Color,Tag="TrainingZone",Attributes={
                TrainingIndex=i,Gain=area.Multiplier,RequiredRebirth=area.Required,RequiredPower=0}})
        label(holder,"Training label",pos+Vector3.new(0,8.5,0),area.Multiplier.."× 力量训练\n"..(area.Required==0 and "开放" or "需重生 "..area.Required.." 次"))
        part(training,"PadBase"..i,Vector3.new(18,.25,22),CFrame.new(pos-Vector3.new(0,.5,0)),Color3.fromRGB(140,150,145),true)
        task.wait()
    end
    local public=game.ReplicatedStorage:FindFirstChild("MiningVisualAssets")
    if not public then public=Instance.new("Folder");public.Name="MiningVisualAssets";public.Parent=game.ReplicatedStorage end
    if not public:FindFirstChild("OreRock") then
        local ore=game.ServerStorage.GameAssets.Ores.SandstoneOre:Clone()
        ore.Name="OreRock"
        for _,o in ore:GetDescendants() do if o:IsA("BasePart") then o.Anchored=true;o.CanCollide=false;o.CanQuery=false;o.CanTouch=false end end
        ore.Parent=public
    end
    camp.ToolShop.Upgrade.Interact.ActionText="打开镐子商店"
    camp:SetAttribute("CoreWorldVersion",1)
    return camp
end
return World
]]></ProtectedString>
