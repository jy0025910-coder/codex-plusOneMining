					<ProtectedString name="Source"><![CDATA[-- Shared presentation timing keeps automatic swings and impact feedback aligned.
return {
    AutoSwingSpeed = 1.5,
    Grip = CFrame.Angles(0, math.rad(90), 0),
    WindupTime = .17,
    ImpactTime = .27,
    HoldTime = .34,
    StrokeDuration = .60,
}

]]></ProtectedString>
					<string name="ScriptGuid">{C2CD5B83-1AFA-418B-BBAE-F0964636D704}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MiningStyle</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff700004b40</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9DB8C32CCC84470DB30DECEFA2EAFA1E">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local Debris=game:GetService("Debris")
local Impact={}
local shakes=setmetatable({},{__mode="k"})

local function shake(visual,large)
    if not visual then return end
    local previous=shakes[visual]
    local scope={rest=previous and previous.rest or visual:GetPivot()}
    shakes[visual]=scope
    task.spawn(function()
        local started=os.clock()
        while visual.Parent and shakes[visual]==scope do
            local t=os.clock()-started
            if t>=.26 then break end
            local decay=(1-t/.26)^2
            local strength=large and .31 or .16
            local offset=Vector3.new(math.sin(t*85)*strength,math.sin(t*58)*.08,math.cos(t*73)*strength*.6)*decay
            visual:PivotTo(scope.rest*CFrame.new(offset)*CFrame.Angles(0,math.sin(t*67)*.035*decay,math.sin(t*82)*.042*decay))
            RunService.RenderStepped:Wait()
        end
        if shakes[visual]==scope then
            if visual.Parent then visual:PivotTo(scope.rest)end
            shakes[visual]=nil
        end
    end)
end

function Impact.Play(target,root,rng)
    local valid=target and target:IsA("BasePart") and target:IsDescendantOf(workspace)
    local large=valid and target:GetAttribute("LargeImpact")==true
    local stone=valid and target.Color or Color3.fromRGB(214,170,111)
    local mineral=valid and target:GetAttribute("ImpactColor") or Color3.fromRGB(255,213,117)
    local contact=root.Position+root.CFrame.LookVector*3
    local center=contact
    if valid then
        local localRoot=target.CFrame:PointToObjectSpace(root.Position)
        local x=math.clamp(localRoot.X,-target.Size.X*.48,target.Size.X*.48)
        local z=math.clamp(localRoot.Z,-target.Size.Z*.48,target.Size.Z*.48)
        local y=math.clamp(localRoot.Y+.1,-target.Size.Y*.5+.6,target.Size.Y*.5-.3)
        contact=target.CFrame:PointToWorldSpace(Vector3.new(x,y,z))
        center=Vector3.new(target.Position.X,contact.Y,target.Position.Z)
        local visual=target.Parent:FindFirstChild("RockVisual")
        local flash=Instance.new("Highlight");flash.Name="RockHitFlash"
        flash.Adornee=visual or target;flash.FillColor=Color3.new(1,1,1);flash.FillTransparency=large and .22 or .38
        flash.OutlineTransparency=1;flash.DepthMode=Enum.HighlightDepthMode.Occluded;flash.Parent=target
        TweenService:Create(flash,TweenInfo.new(.18,Enum.EasingStyle.Quad),{FillTransparency=1}):Play()
        Debris:AddItem(flash,.21)
        shake(visual,large)
    end
    local count=large and 28 or valid and 16 or 7
    for i=1,count do
        local chip=Instance.new(i%3==0 and "WedgePart" or "Part")
        chip.Name="MiningChip"
        local size=large and rng:NextNumber(.30,.85) or rng:NextNumber(.13,.40)
        chip.Size=Vector3.new(size,size*rng:NextNumber(.65,1.1),size*rng:NextNumber(.7,1.2))
        chip.Color=i%3==0 and mineral or stone:Lerp(Color3.fromRGB(255,231,187),rng:NextNumber(0,.25))
        chip.Material=Enum.Material.SmoothPlastic;chip.Anchored=true;chip.CanCollide=false;chip.CanQuery=false;chip.CanTouch=false
        local angle=i/count*math.pi*2+rng:NextNumber(-.25,.25)
        local direction=Vector3.new(math.cos(angle),0,math.sin(angle))
        local origin=contact
        if large and i>10 then
            local radius=math.min(target.Size.X,target.Size.Z)*rng:NextNumber(.23,.42)
            origin=center+direction*radius+Vector3.new(0,rng:NextNumber(-.8,1.8),0)
        end
        chip.CFrame=CFrame.new(origin)*CFrame.Angles(rng:NextNumber(0,3),rng:NextNumber(0,3),rng:NextNumber(0,3));chip.Parent=workspace
        local distance=large and rng:NextNumber(3,6) or rng:NextNumber(1.3,2.8)
        local peak=origin+direction*distance*.65+Vector3.new(0,rng:NextNumber(1.4,3.5),0)
        local endPoint=origin+direction*distance-Vector3.new(0,rng:NextNumber(.8,2.6),0)
        TweenService:Create(chip,TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=peak,Orientation=chip.Orientation+Vector3.new(60,80,30)}):Play()
        task.delay(.16,function()
            if chip.Parent then TweenService:Create(chip,TweenInfo.new(.32,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=endPoint,Transparency=1,Orientation=chip.Orientation+Vector3.new(80,60,40)}):Play()end
        end)
        Debris:AddItem(chip,.51)
    end
    local sound=Instance.new("Sound");sound.Name="PickaxeImpact";sound.SoundId="rbxasset://sounds/action_jump_land.mp3"
    sound.Volume=large and .38 or .23;sound.PlaybackSpeed=rng:NextNumber(1.1,1.4);sound.Parent=root;sound:Play();Debris:AddItem(sound,1.2)
end

return Impact
]]></ProtectedString>
					<string name="ScriptGuid">{595902B7-364E-4525-80E6-F0F0E3246429}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RockImpact</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff700005193</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX235D58602FDD4E3DB45CD43B837EE42E">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Style = require(script.Parent.MiningStyle)
local RockImpact = require(script.Parent.RockImpact)
local Feedback = {}
Feedback.__index = Feedback

function Feedback.new(gui, player)
    return setmetatable({gui = gui, player = player, rng = Random.new()}, Feedback)
end

function Feedback:ClickRing(position)
    local ring = Instance.new("Frame")
    ring.Name = "ClickRing"
    ring.AnchorPoint = Vector2.new(.5, .5)
    ring.Position = UDim2.fromOffset(position.X, position.Y)
    ring.Size = UDim2.fromOffset(12, 12)
    ring.BackgroundTransparency = 1
    ring.Parent = self.gui
    local round = Instance.new("UICorner")
    round.CornerRadius = UDim.new(1, 0)
    round.Parent = ring
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 225, 145)
    stroke.Thickness = 2
    stroke.Parent = ring
    TweenService:Create(ring, TweenInfo.new(.25), {Size = UDim2.fromOffset(55, 55)}):Play()
    TweenService:Create(stroke, TweenInfo.new(.25), {Transparency = 1}):Play()
    Debris:AddItem(ring, .28)
end

function Feedback:CreatePowerPopup(amount)
    local template=script.Parent:FindFirstChild("PowerGainTemplate")
    if not template then return end
    local popup=template:Clone();popup.Name="PowerGain";popup.Visible=true
    popup.Amount.Text="+"..amount
    -- Keep older reusable viewport templates compatible; v2 uses a flat image.
    if popup.Icon:IsA("ViewportFrame") then
        local camera=popup.Icon:FindFirstChildOfClass("Camera") or Instance.new("Camera")
        camera.Name="IconCamera";camera.CFrame=popup.Icon:GetAttribute("PreviewCameraFrame")
        camera.FieldOfView=popup.Icon:GetAttribute("PreviewFieldOfView")
        camera.Parent=popup.Icon;popup.Icon.CurrentCamera=camera
    end
    return popup
end

function Feedback:Power(amount)
    local popup=self:CreatePowerPopup(amount)
    if not popup then return end
    local previous=self.lastPowerPosition
    local position
    for _=1,4 do
        position=Vector2.new(self.rng:NextNumber(.23,.77),self.rng:NextNumber(.28,.64))
        if not previous or (position-previous).Magnitude>.16 then break end
    end
    self.lastPowerPosition=position
    popup.Position=UDim2.fromScale(position.X,position.Y)
    popup.Rotation=self.rng:NextNumber(-7,7)
    popup.Parent=self.gui
    local reduced=game:GetService("GuiService").ReducedMotionEnabled
    local viewport=workspace.CurrentCamera.ViewportSize
    local size=math.clamp(math.min(viewport.X/1000,viewport.Y/620),.68,1.18)
    local scale=popup.PopScale
    scale.Scale=reduced and size or size*.65
    if not reduced then
        popup.Icon.Rotation=-12
        TweenService:Create(popup.Icon,TweenInfo.new(.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Rotation=0}):Play()
        TweenService:Create(scale,TweenInfo.new(.16,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=size}):Play()
        TweenService:Create(popup,TweenInfo.new(.78,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=popup.Position-UDim2.fromOffset(0,62*size)}):Play()
    end
    task.delay(.46,function()
        if popup.Parent then TweenService:Create(popup,TweenInfo.new(.26),{GroupTransparency=1}):Play()end
    end)
    Debris:AddItem(popup,.76)
end

function Feedback:Impact(target)
    local character = self.player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    RockImpact.Play(target,root,self.rng)
end

function Feedback:Stroke(target, amount, speed)
    task.delay(Style.ImpactTime / (speed or 1), function()
        self:Impact(target)
        if amount and amount ~= 0 and amount ~= "0" then self:Power(amount) end
    end)
end

return Feedback
]]></ProtectedString>
