					<string name="Name">InventoryService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET000003">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- A shop owns its sign and mount points. Each visible tintable part declares its role.
local assets = game:GetService("ServerStorage"):WaitForChild("GameAssets")
local Factory = {}

function Factory.CreateStall(parent, name, placement, options)
    options = options or {}
    local stall = assets.Buildings.MarketStall:Clone()
    stall.Name = name
    stall.SignAnchor.Lettering.Title.Text = options.Title or "矿石收购"
    for _, part in stall:GetDescendants() do
        local role = part:GetAttribute("TintRole")
        if role and options[role] and part:IsA("BasePart") then
            part.Color = options[role]
        end
    end
    stall:PivotTo(placement)
    stall.Parent = parent
    return stall
end

function Factory.AttachMerchant(stall, options)
    options = options or {}
    local merchant = assets.Characters.ProspectorMerchant:Clone()
    merchant.Name = options.Name or "Merchant"
    merchant:PivotTo(stall.Mounts.NpcMount.CFrame)
    merchant.Parent = stall
    return merchant
end

return Factory
]]></ProtectedString>
					<string name="ScriptGuid">{CFEA1D1C-D772-45DD-AF03-7291A1ECF053}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MerchantAssets</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET000004">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Collection = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Inventory = require(script.Parent.InventoryService)
local Config = require(game.ReplicatedStorage.Shared.PrototypeConfig)
local Catalog = require(game.ReplicatedStorage.Shared.OreCatalog)
local Equipment = require(script.Parent.MiningAssets)
local Motion = require(script.Parent.MiningMotion)
local Style = require(game.ReplicatedStorage.Shared.MiningStyle)
local wire = game.ReplicatedStorage.DigCamp
local Service = {}
local states = {}
local started = false
local rng = Random.new()
local camp

local function living(player)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or humanoid.Health <= 0 then return nil end
    return root, humanoid
end
local function within(player, target, range)
    local root = living(player)
    return root and (root.Position-target.Position).Magnitude <= range
end
local function note(player, text)
    wire.Feedback:FireClient(player,"note",text)
end
local function init(player)
    if states[player] then return end
    local state = {power=1,tier=1,unlocked=0,gates={},nodes={},lastHit=0,training=0,lastNote=0}
    states[player] = state
    Inventory.Create(player)
    player:SetAttribute("Power",1)
    player:SetAttribute("ToolTier",1)
    player:SetAttribute("DeepestLayer",0)
    player:SetAttribute("TrainingGain",0)
    for index, layer in Config.Layers do
        state.gates[index] = layer.WallHealth
        player:SetAttribute("Gate"..index.."HP",layer.WallHealth)
    end
    local function equip(character)
        local h=character:WaitForChild("Humanoid",10)
        local backpack=player:WaitForChild("Backpack",10)
        if not h or not backpack or player.Character~=character then return end
        Equipment.Equip(player, character, h, backpack)
    end
    player.CharacterAdded:Connect(equip)
    if player.Character then task.spawn(equip,player.Character)end
end

function Service.Hit(player,target)
    local state=states[player]
    if not state or typeof(target)~="Instance" or not target:IsA("BasePart") then return end
    if not target:IsDescendantOf(camp.Mine) or not target:HasTag("MineTarget") then return end
    if not within(player,target,19) or os.clock()-state.lastHit<Config.HitInterval then return end
    local character=player.Character
    if not Equipment.GetEquipped(character) then return end
    local index=target:GetAttribute("LayerIndex")
    if typeof(index)~="number" or not Config.Layers[index] then return end
    state.lastHit=os.clock()
    local kind=target:GetAttribute("TargetKind")
    if kind=="Gate" then
        if index~=state.unlocked+1 then return end
        local hp=math.max(0,state.gates[index]-state.power)
        state.power += 1
        player:SetAttribute("Power",state.power)
        Motion.Play(player,target)
        state.gates[index]=hp
        player:SetAttribute("Gate"..index.."HP",hp)
        wire.Feedback:FireClient(player,"hit",target,hp,Config.Layers[index].WallHealth)
        if hp==0 then
            state.unlocked=index
            player:SetAttribute("DeepestLayer",index)
            note(player,"岩壁打通！第 "..index.." 层 · 稀有矿 "..math.round(Config.Layers[index].RareChance*100).."%")
        end
        return
    end
    if kind~="Ore" or index>state.unlocked then return end
    if Inventory.Count(player)>=Catalog.Capacity then note(player,"背包已满，回绿色光幕出售");return end
    local health=state.nodes[target] or Config.Layers[index].OreHealth
    health=math.max(0,health-state.power)
    state.nodes[target]=health
    state.power += 1
    player:SetAttribute("Power",state.power)
    Motion.Play(player,target)
    wire.Feedback:FireClient(player,"hit",target,health,Config.Layers[index].OreHealth)
    if health==0 then
        local roll=rng:NextNumber()
        local rareChance=Config.Layers[index].RareChance
        local oreId
        if roll<rareChance then
            oreId=({"MintCrystal","Amethyst","Gold"})[rng:NextInteger(1,3)]
        else
            oreId=rng:NextNumber()<.45 and "Copper" or "Stone"
        end
        if Inventory.Add(player,oreId) then
            state.nodes[target]=nil
            note(player,"采得 "..Catalog.Items[oreId].Name.." · "..Catalog.Items[oreId].Value.." 金币")
        end
    end
end

function Service.Practice(player, target)
    local state = states[player]
    if not state or not living(player) or not Equipment.GetEquipped(player.Character) then return end
    if os.clock() - state.lastHit < .35 then return end
    if target ~= nil then
        if typeof(target) ~= "Instance" or not target:IsA("BasePart") then return end
        if not target:IsDescendantOf(camp.Training) or not target:HasTag("TrainingTarget") then return end
        if not within(player,target,19) then return end
        local index = target:GetAttribute("TrainingIndex")
        if not Config.Trainings[index] or state.power < Config.Trainings[index].Required then return end
    end
    state.lastHit = os.clock()
    state.power += 1
    player:SetAttribute("Power",state.power)
    Motion.Play(player,target)
    wire.Feedback:FireClient(player,"practice",target,1)
end

local function stepTraining(dt)
    for player,state in states do
        local root=living(player)
        local gain=0
        local rock
        if root and Equipment.GetEquipped(player.Character) then
            for _,zone in Collection:GetTagged("TrainingZone")do
                if not zone:IsDescendantOf(camp) then continue end
                local p=zone.CFrame:PointToObjectSpace(root.Position)
                local half=zone.Size*.5
                if math.abs(p.X)>half.X or math.abs(p.Y)>half.Y or math.abs(p.Z)>half.Z then continue end
                local required=zone:GetAttribute("RequiredPower")
                if state.power<required then
                    if os.clock()-state.lastNote>3 then note(player,"此训练石需要 "..required.." 力量");state.lastNote=os.clock()end
                    break
                end
                gain=zone:GetAttribute("Gain")
                rock=camp.Training["TrainingRock"..zone:GetAttribute("TrainingIndex")].Target
                break
            end
        end
        if gain == 0 and (player:GetAttribute("TrainingGain") or 0) > 0 then Motion.Stop(player) end
        player:SetAttribute("TrainingGain",gain)
        if gain>0 then
            state.training+=dt
            if state.training>=Config.TrainingInterval then
                state.training-=Config.TrainingInterval
                state.power+=gain
                player:SetAttribute("Power",state.power)
                Motion.Play(player,rock,Style.AutoSwingSpeed)
                wire.Feedback:FireClient(player,"train",rock,gain,Style.AutoSwingSpeed)
            end
        else
            state.training=0
        end
        if root then
            -- Physical gate visuals are local. Progress is also enforced by the server.
            local nextGate=camp.Mine:FindFirstChild("Layer"..(state.unlocked+1))
            if nextGate then
                local gate=nextGate.Gate
                local p=gate.CFrame:PointToObjectSpace(root.Position)
                if p.Z<-.9 and math.abs(p.X)<18 then
                    player.Character:PivotTo(gate.CFrame*CFrame.new(0,-gate.Size.Y/2+3,4))
                end
            end
        end
    end
end
local function updateBoards()
    for _,board in Collection:GetTagged("CampLeaderboard")do
        local stat=board:GetAttribute("BoardStat")
        local list=Players:GetPlayers()
        table.sort(list,function(a,b)
            local av,bv=a:GetAttribute(stat)or 0,b:GetAttribute(stat)or 0
            if av==bv then return a.UserId<b.UserId end
            return av>bv
        end)
        for i=1,6 do
            local p=list[i]
            board.Scores.Frame["Row"..i].Text=p and (i.."  "..p.DisplayName.."   "..(p:GetAttribute(stat)or 0)) or ""
        end
    end
end

function Service.Start()
    if started then return end
    started=true
    camp=require(script.Parent.WorldBuilder).Build()
    Players.PlayerAdded:Connect(init)
    Players.PlayerRemoving:Connect(function(p)states[p]=nil;Motion.Stop(p)end)
    for _,p in Players:GetPlayers()do init(p)end
    wire.Dig.OnServerEvent:Connect(Service.Hit)
    wire:WaitForChild("Practice").OnServerEvent:Connect(Service.Practice)
    local returnEvent=wire:FindFirstChild("ReturnToCamp")
    if not returnEvent then
        returnEvent=Instance.new("RemoteEvent")
        returnEvent.Name="ReturnToCamp"
        returnEvent.Parent=wire
    end
    local returnTimes={}
    returnEvent.OnServerEvent:Connect(function(player)
        if not living(player) or os.clock()-(returnTimes[player]or 0)<2 then return end
        returnTimes[player]=os.clock()
        player.Character:PivotTo(camp.Arrival.CFrame*CFrame.new(0,3,0))
    end)
    Players.PlayerRemoving:Connect(function(player)returnTimes[player]=nil end)
    local prompt=camp.ToolShop.Upgrade.Interact
    prompt.Triggered:Connect(function(player)
        local state=states[player]
        if not state or not within(player,camp.ToolShop.Upgrade,15)then return end
        local costs={16,48}
        local cost=costs[state.tier]
        if not cost then note(player,"本次试玩已升满");return end
        if not Inventory.Spend(player,cost)then note(player,"还需要 "..cost.." 金币升级");return end
        state.tier+=1
        player:SetAttribute("ToolTier",state.tier)
        -- Tool upgrades add a permanent amount of power for this session.
        state.power+=({0,15,45})[state.tier]
        player:SetAttribute("Power",state.power)
        note(player,"工具升级，力量增加")
    end)
    local accumulator,boards=0,0
    RunService.Heartbeat:Connect(function(dt)
        accumulator+=dt;boards+=dt
        if accumulator>=.05 then local elapsed=accumulator;accumulator=0;stepTraining(elapsed)end
        if boards>=2 then boards=0;updateBoards()end
    end)
end

return Service
]]></ProtectedString>
					<string name="ScriptGuid">{D8052504-5F55-4819-9CEA-2499179F3613}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MiningService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET000005">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Inventory = require(script.Parent.InventoryService)
local Feedback = game:GetService("ReplicatedStorage").DigCamp.Feedback

local SellZones = {}
local connection
local elapsed = 0

function SellZones.Contains(zone, root)
    local p = zone.CFrame:PointToObjectSpace(root.Position)
    local half = zone.Size * .5
    return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y and math.abs(p.Z) <= half.Z
end

function SellZones.Step()
    local zones = CollectionService:GetTagged("OreSellZone")
    for _, player in Players:GetPlayers() do
        if Inventory.Count(player) == 0 then continue end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then continue end
        for _, zone in zones do
            if not zone:IsA("BasePart") or not zone:IsDescendantOf(workspace) then continue end
            if zone:GetAttribute("Enabled") == false then continue end
            if not SellZones.Contains(zone, root) then continue end
            local receipt = Inventory.SellAll(player)
            if receipt then
                Feedback:FireClient(player, "sale", receipt.Total, receipt.Count)
                zone:SetAttribute("LastSaleCount", receipt.Count)
                zone:SetAttribute("LastSaleTotal", receipt.Total)
            end
            break
        end
    end
end

function SellZones.Start()
    if connection then return end
    connection = RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < .15 then return end
        elapsed = 0
        SellZones.Step()
    end)
end

return SellZones
]]></ProtectedString>
					<string name="ScriptGuid">{E25098F9-DD9F-44FD-B7A2-99723F4D8651}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">SellZoneService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET980002">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local assets = game:GetService("ServerStorage"):WaitForChild("GameAssets")
local Visuals = {}

-- One editable prefab supplies the gradient, double border and sparse stars.
function Visuals.Create(parent, name, placement, options)
    options = options or {}
    local zone = assets.Interactions.AutoSellZone:Clone()
    zone.Name = name
    zone:PivotTo(CFrame.identity)
    local trigger = zone.Trigger
    trigger:RemoveTag("OreSellZone")
    trigger:SetAttribute("Enabled", options.Sell == true)
    if options.Sell then trigger:AddTag("OreSellZone") end
    if options.Tag then trigger:AddTag(options.Tag) end
    for key, value in options.Attributes or {} do trigger:SetAttribute(key,value) end
    if zone:FindFirstChild("FloorLabel") then
        zone.FloorLabel.Lettering.Title.Text = options.Label or ""
    end
    if options.Color then
        for _, object in zone:GetDescendants() do
            if object:IsA("UIGradient") then
                object.Color = ColorSequence.new(options.Color:Lerp(Color3.new(1,1,1),.45),options.Color)
            elseif object:IsA("BasePart") and object.Material == Enum.Material.Neon then
                object.Color = options.Color
            elseif object:IsA("ParticleEmitter") then
                object.Color = ColorSequence.new(options.Color:Lerp(Color3.new(1,1,1),.65))
            end
        end
    end
    zone:PivotTo(placement)
    zone.Parent = parent
    return zone
end

return Visuals
]]></ProtectedString>
					<string name="ScriptGuid">{5FAE0EEE-B8D3-4291-95C1-81B82A6C8897}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ZoneVisuals</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190e</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET980003">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.Shared.PrototypeConfig)
local Visuals = require(script.Parent.ZoneVisuals)
local Factory = require(script.Parent.MerchantAssets)
local assets = game.ServerStorage.GameAssets
local MiningAssets = require(script.Parent.MiningAssets)
local Builder = {}
local V, C = Vector3.new, CFrame.new
local sand = Color3.fromRGB(218,177,119)
local rock = Color3.fromRGB(178,117,77)
local slate = Color3.fromRGB(99,105,105)
local cream = Color3.fromRGB(255,239,194)

local function model(parent,name)
    local m=Instance.new("Model")
    m.Name=name
    m.Parent=parent
    return m
end
local function part(parent,name,size,cf,color,solid,material)
    local p=Instance.new("Part")
    p.Name=name
    p.Size=size
    p.CFrame=cf
    p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.Anchored=true
    p.CanCollide=solid==true
    p.CanTouch=false
    p.CanQuery=solid==true
    p.TopSurface=Enum.SurfaceType.Smooth
    p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent
    return p
end
local function label(parent,name,cf,size,caption,color)
    local anchor=part(parent,name,V(.1,.1,.1),cf,cream)
    anchor.Transparency=1
    anchor.CanQuery=false
    local gui=Instance.new("BillboardGui")
    gui.Name="Lettering"
    gui.Size=UDim2.fromScale(size.X,size.Y)
    gui.MaxDistance=100
    gui.LightInfluence=0
    gui.Parent=anchor
    local text=Instance.new("TextLabel")
    text.Name="Title"
    text.Size=UDim2.fromScale(1,1)
    text.BackgroundTransparency=1
    text.Font=Enum.Font.GothamBold
    text.TextScaled=true
    text.Text=caption
    text.TextColor3=color or cream
    text.TextStrokeColor3=Color3.fromRGB(54,45,37)
    text.TextStrokeTransparency=.15
    text.Parent=gui
    return text
end
local function lamp(parent,x,z)
    part(parent,"Lantern foot",V(1,.3,1),C(x,.15,z),slate,true)
    part(parent,"Lantern post",V(.32,2.2,.32),C(x,1.4,z),slate,true)
    local glass=part(parent,"Warm lamp",V(.65,.8,.65),C(x,2.7,z),cream,false,Enum.Material.Neon)
    part(parent,"Lantern cap",V(.9,.18,.9),C(x,3.2,z),slate)
    local light=Instance.new("PointLight")
    light.Color=Color3.fromRGB(255,210,134)
    light.Brightness=.7
    light.Range=12
    light.Parent=glass
end
local function ore(parent,name,pos,color,crystal)
    local m=model(parent,name)
    local main=part(m,"Target",V(4.8,3.8,4.2),C(pos+V(0,2.2,0)),color,true)
    m.PrimaryPart=main
    local index=tonumber(name:match("%d+")) or 1
    MiningAssets.ReplaceRock(m,index,name:find("TrainingRock")~=nil,color)
    return m,main
end
local function board(parent,x,title,color,kind)
    local m=model(parent,kind)
    local panel=part(m,"Board",V(10,12,.5),C(x,7.1,4)*CFrame.Angles(0,-.16,0),color,true)
    local surface=Instance.new("SurfaceGui")
    surface.Name="Scores"
    surface.Face=Enum.NormalId.Back
    surface.CanvasSize=Vector2.new(540,660)
    surface.LightInfluence=0
    surface.Parent=panel
    local frame=Instance.new("Frame")
    frame.Size=UDim2.fromScale(1,1)
    frame.BackgroundColor3=Color3.fromRGB(38,57,60)
    frame.BorderSizePixel=8
    frame.BorderColor3=color
    frame.Parent=surface
    for i=0,6 do
        local t=Instance.new("TextLabel")
        t.Name=i==0 and "Title" or "Row"..i
        t.Position=UDim2.fromOffset(22,18+i*86)
        t.Size=UDim2.fromOffset(496,i==0 and 70 or 64)
        t.BackgroundTransparency=1
        t.TextColor3=i==0 and color or cream
        t.Font=Enum.Font.GothamBold
        t.TextScaled=true
        t.Text=i==0 and title or (i==1 and "等待矿工上榜" or "")
        t.Parent=frame
    end
    panel:SetAttribute("BoardStat",kind)
    panel:AddTag("CampLeaderboard")
    for _,dx in {-3.5,3.5}do part(m,"Board leg",V(.5,2,.6),C(x+dx,1,4),slate,true)end
end

function Builder.Build()
    local existing=workspace:FindFirstChild("Gem Gulch")
    if existing and existing:GetAttribute("PrototypeVersion")==Config.Version then return existing end
    local town=model(nil,"Gem Gulch")
    town:SetAttribute("AssetId","World.CanyonTown")
    town:SetAttribute("PrototypeVersion",Config.Version)
    local floor=part(town,"Desert floor",V(130,2,245),C(0,-1,-53),sand,true,Enum.Material.Sand)
    town.PrimaryPart=floor
    local paving=model(town,"Sandstone paving")
    -- Warm grey sandstone slabs form a clear plaza with alternating long joints.
    for row=0,13 do
        for col=0,17 do
            local x=-51+col*6
            local z=-24+row*5
            local brightness=(row+col)%3*5
            part(paving,"Sandstone slab",V(5.91,.16,4.91),C(x,.08,z),Color3.fromRGB(173+brightness,164+brightness,144+brightness),true)
        end
    end
    local landscaping=model(town,"Canyon rim")
    for _,side in {-1,1} do
        for i=0,8 do
            local z=42-i*10
            local h=14+(i%3)*4
            part(landscaping,"Sandstone cliff",V(11,h,10.3),C(side*61,h/2,z),rock,true,Enum.Material.Sandstone)
            part(landscaping,"Cliff cap",V(11.4,.7,10.5),C(side*61,h+.2,z),sand,true)
        end
    end
    -- At the rear, the canyon opens into one narrow mine.
    for _,x in {-39,39}do
        part(landscaping,"Mine shoulder",V(44,24,12),C(x,12,-30),rock,true,Enum.Material.Sandstone)
        part(landscaping,"Mine shoulder cap",V(45,1,13),C(x,24,-30),sand,true)
    end
    part(landscaping,"Mine lintel cliff",V(30,9,12),C(0,21,-30),rock,true,Enum.Material.Sandstone)
    local spawn=Instance.new("SpawnLocation")
    spawn.Name="Arrival"
    spawn.Size=V(7,.2,6)
    spawn.CFrame=C(0,.25,36)
    spawn.Anchored=true
    spawn.Neutral=true
    spawn.Transparency=1
    spawn.CanCollide=false
    spawn.Duration=0
    spawn.Parent=town
    label(town,"Hub title",C(0,11,34),Vector2.new(18,2),"晶脉峡谷  ·  矿工休息站")
    local buyer=assets.Stations.OreBuyer:Clone()
    buyer.Name="OreBuyer"
    buyer:PivotTo(C(-17,.18,27))
    buyer.Parent=town
    -- Reuse the existing NPC and counter contract for the tool store.
    local shop=Factory.CreateStall(town,"ToolShop",C(17,.18,27),{Title="镐子铺",Canopy=Color3.fromRGB(66,173,212),Accent=Color3.fromRGB(70,121,132)})
    Factory.AttachMerchant(shop)
    local upgrade=part(shop,"Upgrade",V(.2,.2,.2),C(17,3.5,30),cream)
    upgrade.Transparency=1
    local prompt=Instance.new("ProximityPrompt")
    prompt.Name="Interact";prompt.ActionText="升级工具 · 16 金币";prompt.ObjectText="镐子铺";prompt.MaxActivationDistance=10;prompt.RequiresLineOfSight=false;prompt.Parent=upgrade
    Visuals.Create(shop,"ShopZone",C(17,.18,35),{Color=Color3.fromRGB(61,190,245)})
    local training=model(town,"Training")
    label(training,"Training title",C(-34,11,8),Vector2.new(17,2),"训练矿场",Color3.fromRGB(138,230,228))
    for i,cfg in Config.Trainings do
        local z=18-(i-1)*14
        local pad=Visuals.Create(training,"TrainingPad"..i,C(-35,.19,z),{
            Color=cfg.Color,Tag="TrainingZone",Attributes={TrainingIndex=i,Gain=cfg.Gain,RequiredPower=cfg.Required},
        })
        local m,target=ore(training,"TrainingRock"..i,V(-35,.2,z),cfg.Color,i>1)
        target.CanQuery=true
        m:SetAttribute("TrainingIndex",i)
        label(m,"Training label",C(-35,7.7,z),Vector2.new(13,2.2),cfg.Name.."\n+"..cfg.Gain.." 力量 / 次"..(cfg.Required>0 and (" · 需 "..cfg.Required) or ""))
    end
    local rankings=model(town,"Rankings")
    label(rankings,"Rank title",C(34,16,1),Vector2.new(18,2),"矿工荣誉榜",Color3.fromRGB(255,209,110))
    board(rankings,27,"力量榜",Color3.fromRGB(255,198,84),"Power")
    board(rankings,40,"金币榜",Color3.fromRGB(93,221,156),"Coins")
    label(rankings,"Board scope",C(34,1,12),Vector2.new(16,1),"当前服务器")
    local mine=model(town,"Mine")
    label(mine,"Mine title",C(0,15,-23),Vector2.new(22,2.4),"深入矿洞",cream)
    for _,x in {-13.5,13.5}do
        part(mine,"Entrance timber",V(1.2,13,1.3),C(x,6.5,-23),Color3.fromRGB(113,76,48),true)
    end
    part(mine,"Entrance beam",V(29,1.2,1.5),C(0,13,-23),Color3.fromRGB(139,96,59),true)
    for i,cfg in Config.Layers do
        local front=-25-(i-1)*34
        local room=model(mine,"Layer"..i)
        room:SetAttribute("LayerIndex",i)
        room:SetAttribute("RareChance",cfg.RareChance)
        part(room,"Cave floor",V(28,.3,34),C(0,.1,front-17),Color3.fromRGB(134-i*9,126-i*8,108-i*6),true,Enum.Material.Slate)
        for _,side in {-1,1}do
            part(room,"Cave side",V(3,15,34),C(side*15,7.5,front-17),rock:Lerp(slate,.3+i*.1),true,Enum.Material.Sandstone)
            for j=0,2 do part(room,"Rock rib",V(2,12,3),C(side*13.8,6,front-7-j*10),Color3.fromRGB(125,102,83),true)end
        end
        part(room,"Cave ceiling",V(33,2,34),C(0,15,front-17),Color3.fromRGB(106,91,77),true,Enum.Material.Slate)
        local wall=part(room,"Gate",V(26,11,1.4),C(0,5.5,front),cfg.Color,true,Enum.Material.Sandstone)
        wall:SetAttribute("TargetKind","Gate")
        wall:SetAttribute("LayerIndex",i)
        wall:SetAttribute("MaxHealth",cfg.WallHealth)
        wall:AddTag("MineTarget")
        for j=-3,3 do part(room,"Gate seam",V(.055,10,.04),C(j*3.4,5.5,front+.72),cfg.Color:Lerp(Color3.new(0,0,0),.2))end
        label(room,"Gate label",C(0,11.8,front+1),Vector2.new(23,2.8),"第 "..i.." 层 · "..cfg.Name.."\n岩壁耐久 "..cfg.WallHealth.."  |  稀有矿 "..math.round(cfg.RareChance*100).."%",cream)
        for j=1,3 do
            local x=({-8,7,-6})[j]
            local z=front-9-(j-1)*8
            local m,target=ore(room,"OreNode"..j,V(x,.25,z),cfg.Color,true)
            target:SetAttribute("TargetKind","Ore")
            target:SetAttribute("LayerIndex",i)
            target:SetAttribute("MaxHealth",cfg.OreHealth)
            target:AddTag("MineTarget")
            for _,p in m:GetDescendants()do if p:IsA("BasePart")then p:SetAttribute("TargetRoot",target.Name)end end
            label(m,"Ore label",C(x,6.5,z),Vector2.new(9,1.3),"矿脉 · "..cfg.OreHealth.." 耐久")
        end
        for _,x in {-11,11}do lamp(room,x,front-13)end
    end
    part(mine,"Deep rock end",V(30,15,3),C(0,7.5,-128),slate,true,Enum.Material.Slate)
    label(mine,"Demo end",C(0,5,-123),Vector2.new(20,2),"已到达本次勘探终点")
    for _,p in {{-10,32},{10,32},{-10,15},{10,15},{-10,-7},{10,-7},{-22,5},{22,15}}do lamp(town,p[1],p[2])end
    local old=workspace:FindFirstChild("Gem Gulch")
    town.Parent=workspace
    if old then old:Destroy()end
    return town
end

return Builder
]]></ProtectedString>
					<string name="ScriptGuid">{BCBE36CE-1E9E-4425-B962-664AD1F3F541}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WorldBuilder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190f</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX2511DA93C03C433B85F8028EBA9DAD84">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Style = require(game.ReplicatedStorage.Shared.MiningStyle)
local Motion = {}
local scopes = {}

function Motion.Stop(player)
    local scope = scopes[player]
    if not scope then return end
    scopes[player] = nil
    if scope.character.Parent then
        scope.character:SetAttribute("MiningStrokeAt", nil)
        scope.character:SetAttribute("MiningStrokeSpeed", nil)
    end
    if scope.humanoid.Parent then scope.humanoid.AutoRotate = scope.autoRotate end
end

function Motion.Play(player, target, speed)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or humanoid.Health <= 0 then return end
    local old = scopes[player]
    local autoRotate = old and old.character == character and old.autoRotate or humanoid.AutoRotate
    if old and old.character ~= character then Motion.Stop(player) end
    local scope = {character = character, humanoid = humanoid, autoRotate = autoRotate}
    scopes[player] = scope
    if target and target:IsA("BasePart") then
        local goal = Vector3.new(target.Position.X, root.Position.Y, target.Position.Z)
        if (goal - root.Position).Magnitude > .2 then root.CFrame = CFrame.lookAt(root.Position, goal) end
    end
    humanoid.AutoRotate = false
    speed = speed or 1
    character:SetAttribute("MiningStrokeSpeed", speed)
    character:SetAttribute("MiningStrokeAt", workspace:GetServerTimeNow())
    task.delay(Style.StrokeDuration / speed, function()
        if scopes[player] == scope then Motion.Stop(player) end
    end)
end

Players.PlayerRemoving:Connect(Motion.Stop)
return Motion
]]></ProtectedString>
					<string name="ScriptGuid">{897321E0-60D1-493C-AE5A-9D000B9A54BD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MiningMotion</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff7000029af</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX38239235D82F440982BD05B8541BDBD6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local assets = game:GetService("ServerStorage"):WaitForChild("GameAssets")
local Style = require(game.ReplicatedStorage.Shared.MiningStyle)
local Factory = {}

function Factory.GetEquipped(character)
    if not character then return nil end
    for _, child in character:GetChildren() do
        if child:IsA("Tool") and child:GetAttribute("AssetId") == "Tool.IronPickaxe" then
            return child
        end
    end
    return nil
end

function Factory.Equip(player, character, humanoid, backpack)
    if player.Character ~= character then return nil end
    local current = Factory.GetEquipped(character)
    if current then return current end
    local tool = assets.Tools.IronPickaxe:Clone()
    tool.Name = "铁镐"
    tool.Grip = Style.Grip
    for _, part in tool:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.Massless = true
            part.CanCollide = false
        end
    end
    tool.Parent = backpack
    humanoid:EquipTool(tool)
    return tool
end

function Factory.CreateRockVisual(parent, placement, options)
    options = options or {}
    local visual = assets.Ores.SandstoneOre:Clone()
    visual.Name = "RockVisual"
    if options.Scale then visual:ScaleTo(options.Scale) end
    for _, part in visual:GetDescendants() do
        if not part:IsA("MeshPart") then continue end
        local base = part:GetAttribute("BaseColor") or part.Color
        if part:GetAttribute("MeshRole") == "Inclusions" and options.MineralColor then
            local reference = Color3.fromRGB(198, 121, 67)
            local tint = options.MineralColor
            part.Color = Color3.new(math.min(1, base.R / reference.R * tint.R), math.min(1, base.G / reference.G * tint.G), math.min(1, base.B / reference.B * tint.B))
        elseif options.StoneTint then
            local tint = options.StoneTint
            part.Color = Color3.new(base.R * tint.R, base.G * tint.G, base.B * tint.B)
        end
    end
    visual:PivotTo(placement)
    visual.Parent = parent
    return visual
end

function Factory.ReplaceRock(model, index, isTraining, color)
    local target = model:FindFirstChild("Target")
    if not target then return end
    for _, child in model:GetChildren() do
        local oldGeometry = child:IsA("BasePart") and not child:FindFirstChildOfClass("BillboardGui")
        if child ~= target and (oldGeometry or child.Name == "RockVisual") then
            child:Destroy()
        end
    end
    local scale = isTraining and ({1, 1.1, 1.2})[index] or .87
    local rotation = isTraining and ({0, .85, -.55})[index] or index * .5
    local placement = target.CFrame * CFrame.new(0, -2.2, 0) * CFrame.Angles(0, rotation, 0)
    Factory.CreateRockVisual(model, placement, {
        Scale = scale,
        MineralColor = isTraining and index == 1 and Color3.fromRGB(238, 157, 89) or color,
        StoneTint = index > 1 and Color3.fromRGB(210, 218, 216) or Color3.new(1, 1, 1),
    })
    target.Transparency = 1
    target.Shape = Enum.PartType.Block
    target.Size = Vector3.new(5.8, 3.9, 4.8) * scale
    target.CanQuery = true
    if isTraining then
        target:SetAttribute("TargetKind", "Training")
        target:SetAttribute("TrainingIndex", index)
        target:AddTag("TrainingTarget")
    end
end

return Factory
]]></ProtectedString>
