				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Services</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff700001909</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="ASSET000002">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Big = require(Shared.BigInteger)
local Balance = require(Shared.GameBalance)
local Inventory = {}
local accounts = {}
local function replicate(player,account)
    local total = "0"
    for _,item in account.items do total = Big.Add(total,item.Value) end
    player:SetAttribute("Coins",account.coins)
    player:SetAttribute("Capacity",5)
    player:SetAttribute("Ore",#account.items)
    player:SetAttribute("SaleValue",total)
    local bag = player:FindFirstChild("OreInventory")
    if not bag then bag=Instance.new("Folder");bag.Name="OreInventory";bag.Parent=player end
    for i=1,5 do
        local slot=bag:FindFirstChild("Slot"..i)
        if not slot then slot=Instance.new("StringValue");slot.Name="Slot"..i;slot.Parent=bag end
        local item=account.items[i]
        slot.Value=item and tostring(item.Id) or ""
        slot:SetAttribute("UnitValue",item and item.Value or "0")
        slot:SetAttribute("OreName",item and Balance.Minerals[item.Id].Name or "")
        slot:SetAttribute("Quality",item and item.Quality or 100)
    end
end
function Inventory.Create(player)
    if not accounts[player] then accounts[player]={coins="0",items={}};replicate(player,accounts[player]) end
end
function Inventory.Count(player)
    return accounts[player] and #accounts[player].items or 0
end
function Inventory.Balance(player)
    return accounts[player] and accounts[player].coins or "0"
end
function Inventory.Add(player,item)
    local account=accounts[player]
    if not account or #account.items>=5 or type(item)~="table" or not Balance.Minerals[item.Id] or not Big.IsValid(item.Value) then return false end
    table.insert(account.items,table.clone(item))
    replicate(player,account)
    return true
end
function Inventory.SellAll(player)
    local account=accounts[player]
    if not account or #account.items==0 then return nil end
    local total,count="0",#account.items
    for _,item in account.items do
        total=Big.Add(total,item.Value)
        player:SetAttribute("Discovered"..item.Id,true)
    end
    local multiplier=player:GetAttribute("EquippedSecret")==5 and 2 or player:GetAttribute("EquippedSecret")==6 and 3 or 1
    total=Big.Multiply(total,multiplier)
    account.items={}
    account.coins=Big.Add(account.coins,total)
    replicate(player,account)
    local discovered=0
    for id=1,50 do if player:GetAttribute("Discovered"..id) then discovered+=1 end end
    player:SetAttribute("CollectionCount",discovered)
    return {Count=count,Total=total}
end
function Inventory.Spend(player,cost)
    local account=accounts[player]
    if not account or not Big.IsValid(cost) or Big.Compare(cost,"0")<=0 or Big.Compare(account.coins,cost)<0 then return false end
    account.coins=Big.Subtract(account.coins,cost)
    replicate(player,account)
    return true
end
function Inventory.Refresh(player)
    if accounts[player] then replicate(player,accounts[player]) end
end
function Inventory.Export(player)
    local account=accounts[player]
    return account and {coins=account.coins,items=table.clone(account.items)}
end
function Inventory.Import(player,data)
    if type(data)~="table" or not Big.IsValid(data.coins) then return false end
    local account={coins=Big.Normalize(data.coins),items={}}
    for _,item in type(data.items)=="table" and data.items or {} do
        if #account.items<5 and type(item)=="table" and Balance.Minerals[item.Id] and Big.IsValid(item.Value) then
            table.insert(account.items,{Id=item.Id,Value=Big.Normalize(item.Value),Quality=type(item.Quality)=="number" and item.Quality or 100})
        end
    end
    accounts[player]=account
    replicate(player,account)
    return true
end
Players.PlayerRemoving:Connect(function(player)task.delay(5,function()accounts[player]=nil end)end)
return Inventory
]]></ProtectedString>
					<string name="ScriptGuid">{C4E6C279-7991-4788-AAC0-E0D863B0FBBF}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">InventoryService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET000003">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- A shop owns its sign and mount points. Each visible tintable part declares its role.
local assets = game:GetService("ServerStorage"):WaitForChild("GameAssets")
local Factory = {}

function Factory.CreateStall(parent, name, placement, options)
    options = options or {}
    local stall = assets.Buildings.MarketStall:Clone()
    stall.Name = name
    stall.SignAnchor.Lettering.Title.Text = options.Title or "矿石收购"
    for _, part in stall:GetDescendants() do
        local role = part:GetAttribute("TintRole")
        if role and options[role] and part:IsA("BasePart") then
            part.Color = options[role]
        end
    end
    stall:PivotTo(placement)
    stall.Parent = parent
    return stall
end

function Factory.AttachMerchant(stall, options)
    options = options or {}
    local merchant = assets.Characters.ProspectorMerchant:Clone()
    merchant.Name = options.Name or "Merchant"
    merchant:PivotTo(stall.Mounts.NpcMount.CFrame)
    merchant.Parent = stall
    return merchant
end

return Factory
]]></ProtectedString>
					<string name="ScriptGuid">{CFEA1D1C-D772-45DD-AF03-7291A1ECF053}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MerchantAssets</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET000004">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Run = game:GetService("RunService")
local Collection = game:GetService("CollectionService")
local Shared = game.ReplicatedStorage.Shared
local Balance = require(Shared.GameBalance)
local Big = require(Shared.BigInteger)
local Config = require(Shared.PrototypeConfig)
local Inventory = require(script.Parent.InventoryService)
local Equipment = require(script.Parent.MiningAssets)
local Motion = require(script.Parent.MiningMotion)
local Style = require(Shared.MiningStyle)
local wire = game.ReplicatedStorage.DigCamp
local Service = {}
local states = {}
local rng = Random.new()
local camp
local started = false

local function living(player)
    local character=player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if root and humanoid and humanoid.Health>0 then return root,humanoid end
end
local function note(player,message)
    wire.Feedback:FireClient(player,"note",message)
end
local function sync(player,state)
    local level,xp,nextXP=Balance.LevelProgress(state.xp,state.rebirths)
    player:SetAttribute("Power",state.power)
    player:SetAttribute("Level",level)
    player:SetAttribute("XP",xp)
    player:SetAttribute("NextXP",nextXP)
    player:SetAttribute("TotalXP",state.xp)
    player:SetAttribute("Rebirths",state.rebirths)
    player:SetAttribute("ToolTier",state.tier)
    player:SetAttribute("ToolQuality",Balance.Tools[state.tier].Quality)
    player:SetAttribute("Damage",Balance.Damage(state.power,state.tier,state.secret,false))
    player:SetAttribute("RouteIndex",state.route)
    player:SetAttribute("DeepestLayer",state.unlocked)
    player:SetAttribute("EquippedSecret",state.secret)
    local discoveries=0
    for id=1,10 do
        local owned=state.secrets[id]==true
        player:SetAttribute("SecretOwned"..id,owned)
        if owned then discoveries+=1 end
    end
    player:SetAttribute("HiddenCount",discoveries)
    for id=1,10 do player:SetAttribute("ToolOwned"..id,state.tools[id]==true) end
    for i=1,10 do
        player:SetAttribute("Gate"..i.."HP",state.gates[i])
        player:SetAttribute("Gate"..i.."Max",Balance.Routes[state.route].Walls[i])
    end
end
local function updateTool(player,state)
    local tool=Equipment.GetEquipped(player.Character)
    if tool then
        tool.Name=Balance.Tools[state.tier].Name
        tool:SetAttribute("PowerMultiplier",Balance.Tools[state.tier].Multiplier)
        tool:SetAttribute("QualityMultiplier",Balance.Tools[state.tier].Quality/100)
        tool.ToolTip="力量 ×"..Balance.Tools[state.tier].Multiplier.." · 品质 ×"..Balance.Tools[state.tier].Quality/100
    end
end
local function grantStrength(player,state,area)
    local gain=Balance.TrainingGain(area,state.tier,state.rebirths)
    state.power=Big.Add(state.power,gain)
    state.xp=Big.Add(state.xp,gain)
    sync(player,state)
    return gain
end
local function resetMine(player,state,route)
    state.route=route
    state.unlocked=0
    state.gates=table.clone(Balance.Routes[route].Walls)
    state.batch=nil
    state.batchId+=1
    Motion.Stop(player)
    wire.Feedback:FireClient(player,"clearDrops")
    sync(player,state)
end
local function init(player)
    if states[player] then return end
    local state={power="1",xp="0",rebirths=0,tier=1,tools={[1]=true},secrets={},secret=0,
        route=1,unlocked=0,gates=table.clone(Balance.Routes[1].Walls),batchId=0,batch=nil,
        lastPractice=0,lastHit=0,lastAction=0,lastNote=0,training=0}
    states[player]=state
    Inventory.Create(player)
    player:SetAttribute("CollectionCount",0)
    player:SetAttribute("ProgressStorage","Session")
    local function equip(character)
        local humanoid=character:WaitForChild("Humanoid",10)
        local backpack=player:WaitForChild("Backpack",10)
        if not humanoid or not backpack or player.Character~=character then return end
        Equipment.Equip(player,character,humanoid,backpack)
        updateTool(player,state)
    end
    player.CharacterAdded:Connect(equip)
    if player.Character then task.spawn(equip,player.Character) end
    sync(player,state)
end
function Service.Practice(player)
    local state=states[player]
    if not state or not living(player) or not Equipment.GetEquipped(player.Character) then return end
    local now=os.clock()
    if now-state.lastPractice<Config.PracticeInterval then return end
    state.lastPractice=now
    wire.Feedback:FireClient(player,"practice",nil,grantStrength(player,state,1))
end
local function reveal(player,state,index)
    local quality=Balance.Tools[state.tier].Quality
    local gate=camp.Mine["Layer"..index].Gate
    local batch={}
    for i=1,5 do
        local id=Balance.RollMineral(state.route,index,rng)
        table.insert(batch,{
            Id=id,Value=Balance.Price(id,state.route,index,quality),Quality=quality,
            Position=gate.Position+Vector3.new((i-3)*4,-3.5,-9),Taken=false})
    end
    if rng:NextNumber()<Balance.HiddenChance(state.route,index,state.tier,state.power,state.secret) then
        table.insert(batch,{Secret=Balance.RollSecret(state.route,rng),
            Position=gate.Position+Vector3.new(0,-2,-15),Taken=false})
    end
    state.batchId+=1;state.batch=batch
    wire.Feedback:FireClient(player,"reveal",state.batchId,batch)
end
local function hitGate(player,state,gate)
    local index=gate:GetAttribute("LayerIndex")
    if index~=state.unlocked+1 or os.clock()-state.lastHit<Config.HitInterval then return end
    local root=living(player)
    if not root or not Equipment.GetEquipped(player.Character) then return end
    local point=gate.CFrame:PointToObjectSpace(root.Position)
    if math.abs(point.X)>13 or point.Z<0 or point.Z>Config.AutoGateDistance then return end
    if state.batch then
        for _,drop in state.batch do
            if not drop.Taken then
                if os.clock()-state.lastNote>4 then note(player,"先拾取本层掉落，或回营出售后重新进矿");state.lastNote=os.clock() end
                return
            end
        end
    end
    state.lastHit=os.clock()
    local damage=Balance.Damage(state.power,state.tier,state.secret,player:GetAttribute("Overheated")==true)
    state.gates[index]=Big.Subtract(state.gates[index],damage)
    player:SetAttribute("Gate"..index.."HP",state.gates[index])
    Motion.Play(player,gate,Style.AutoSwingSpeed)
    wire.Feedback:FireClient(player,"hit",gate,state.gates[index],Balance.Routes[state.route].Walls[index])
    if state.gates[index]=="0" then
        state.unlocked=index
        player:SetAttribute("DeepestLayer",index)
        reveal(player,state,index)
        note(player,"矿墙打通！五块矿石已出现，走近拾取")
    end
end
local function pickup(player,state,batchId,index)
    if type(batchId)~="number" or type(index)~="number" or index%1~=0 or not state.batch or batchId~=state.batchId then return end
    local item=state.batch[index]
    local root=living(player)
    if not item or item.Taken or not root or (root.Position-item.Position).Magnitude>12 then return end
    if item.Secret then
        item.Taken=true
        state.secrets[item.Secret]=true
        if item.Secret==10 then state.tools[10]=true end
        sync(player,state)
        note(player,"发现隐藏款 · "..Balance.Secrets[item.Secret].Name)
    else
        if not Inventory.Add(player,{Id=item.Id,Value=item.Value,Quality=item.Quality}) then note(player,"五格背包已满，回绿色光幕出售");return end
        item.Taken=true
        note(player,Balance.Minerals[item.Id].Name.." · "..Big.Format(item.Value).." 矿币")
    end
    wire.Feedback:FireClient(player,"pickup",batchId,index)
end
local function action(player,kind,value,extra)
    local state=states[player]
    if not state or not living(player) or type(kind)~="string" then return end
    if kind=="Pickup" then pickup(player,state,value,extra);return end
    if os.clock()-state.lastAction<.2 then return end
    state.lastAction=os.clock()
    if kind=="Buy" or kind=="Equip" then
        if type(value)~="number" or value%1~=0 or not Balance.Tools[value] then return end
        local tool=Balance.Tools[value]
        if kind=="Buy" and not state.tools[value] then
            if value==10 then note(player,"罗盘镐来自隐藏掉落");return end
            if state.rebirths<tool.Rebirth then note(player,"此镐需重生 "..tool.Rebirth.." 次");return end
            if not Inventory.Spend(player,tool.Price) then note(player,"矿币不足，售价 "..Big.Format(tool.Price));return end
            state.tools[value]=true
        end
        if not state.tools[value] then return end
        state.tier=value;updateTool(player,state);sync(player,state)
        note(player,"已装备 "..tool.Name.." · 品质 ×"..tool.Quality/100)
    elseif kind=="Route" then
        if type(value)~="number" or value%1~=0 or not Balance.Routes[value] then return end
        if state.rebirths<Balance.Routes[value].Required then note(player,"此矿道需重生 "..Balance.Routes[value].Required.." 次");return end
        if Inventory.Count(player)>0 then note(player,"先到绿色光幕出售背包里的矿，再重新进矿");return end
        resetMine(player,state,value)
        player.Character:PivotTo(camp.Mine.Layer1.Gate.CFrame*CFrame.new(0,-2,7))
        note(player,"进入 "..Balance.Routes[value].Name.." · 靠近墙自动挥镐")
    elseif kind=="Rebirth" then
        if state.rebirths>=20 then note(player,"已完成二十次重生");return end
        if Balance.LevelProgress(state.xp,state.rebirths)<50 then note(player,"本轮达到 50 级即可重生");return end
        state.rebirths+=1;state.power="1";state.xp="0"
        resetMine(player,state,1)
        player.Character:PivotTo(camp.Arrival.CFrame*CFrame.new(0,3,0))
        note(player,"重生成功！训练加成 ×"..Big.Format(Big.Power(4,state.rebirths)))
    elseif kind=="Secret" then
        if type(value)~="number" or value%1~=0 or value<0 or value>10 then return end
        if value~=0 and not state.secrets[value] then return end
        if value==10 then
            state.tier=10;updateTool(player,state)
        else state.secret=value end
        sync(player,state)
        note(player,value==0 and "已卸下秘技" or "已装备 "..Balance.Secrets[value].Name)
    end
end
local function trainingAt(state,root)
    for _,zone in Collection:GetTagged("TrainingZone") do
        if not zone:IsDescendantOf(camp.Training) then continue end
        local point=zone.CFrame:PointToObjectSpace(root.Position)
        local half=zone.Size*.5
        if math.abs(point.X)<=half.X and math.abs(point.Y)<=half.Y and math.abs(point.Z)<=half.Z then
            local index=zone:GetAttribute("TrainingIndex")
            local profile=Balance.Trainings[index]
            if profile and state.rebirths>=profile.Required then
                return profile.Multiplier,camp.Training["TrainingRock"..index].Target
            end
            return 0,nil,profile and profile.Required
        end
    end
    return 0
end
local function step(dt)
    for player,state in states do
        local root,humanoid=living(player)
        if not root then continue end
        local area,rock,locked=trainingAt(state,root)
        local equipped=Equipment.GetEquipped(player.Character)
        if not equipped then area=0 end
        if locked and os.clock()-state.lastNote>4 then note(player,"此训练区需重生 "..locked.." 次");state.lastNote=os.clock() end
        player:SetAttribute("TrainingGain",area)
        local nextRoom=camp.Mine:FindFirstChild("Layer"..(state.unlocked+1))
        local inMine=root.Position.Z<-76
        local hot=inMine and state.route==3 and (os.clock()%8)>5
        player:SetAttribute("Overheated",hot)
        local walkSpeed=inMine and state.route==4 and 10.4 or 16
        humanoid.WalkSpeed=state.secret==3 and walkSpeed*1.15 or walkSpeed
        if area>0 then
            state.training+=dt
            if state.training>=Config.TrainingInterval then
                state.training=0
                local gain=grantStrength(player,state,area)
                Motion.Play(player,rock,Style.AutoSwingSpeed)
                wire.Feedback:FireClient(player,"train",rock,gain,Style.AutoSwingSpeed)
            end
            player:SetAttribute("AutoMining",false)
        else
            state.training=0
            local near=equipped and nextRoom and (root.Position-nextRoom.Gate.Position).Magnitude<19
            player:SetAttribute("AutoMining",near==true)
            if near then hitGate(player,state,nextRoom.Gate) end
        end
        if nextRoom then
            local point=nextRoom.Gate.CFrame:PointToObjectSpace(root.Position)
            if point.Z<-.9 and math.abs(point.X)<18 then
                player.Character:PivotTo(nextRoom.Gate.CFrame*CFrame.new(0,-2,4))
            end
        end
    end
end
local function updateBoards()
    local rankings=camp:FindFirstChild("Rankings")
    if not rankings then return end
    for _,spec in {{"Power","CollectionCount","矿石图鉴榜"},{"Coins","HiddenCount","隐藏收藏榜"}} do
        local model=rankings:FindFirstChild(spec[1])
        local board=model and model:FindFirstChild("Board")
        local frame=board and board.Scores.Frame
        if not frame then continue end
        frame.Title.Text=spec[3]
        local list=Players:GetPlayers()
        table.sort(list,function(a,b)
            local av,bv=a:GetAttribute(spec[2])or 0,b:GetAttribute(spec[2])or 0
            return av==bv and a.UserId<b.UserId or av>bv
        end)
        for i=1,6 do
            local p=list[i]
            frame["Row"..i].Text=p and (i.."  "..p.DisplayName.."  "..(p:GetAttribute(spec[2])or 0)) or ""
        end
    end
end
function Service.Start()
    if started then return end
    started=true
    camp=require(script.Parent.ProgressionWorld).Build(require(script.Parent.WorldBuilder).Build())
    for _,name in {"Action","OpenPanel"} do
        if not wire:FindFirstChild(name) then local event=Instance.new("RemoteEvent");event.Name=name;event.Parent=wire end
    end
    Players.PlayerAdded:Connect(init)
    Players.PlayerRemoving:Connect(function(player)states[player]=nil;Motion.Stop(player)end)
    for _,player in Players:GetPlayers() do init(player) end
    wire.Practice.OnServerEvent:Connect(Service.Practice)
    wire.Action.OnServerEvent:Connect(action)
    wire.ReturnToCamp.OnServerEvent:Connect(function(player)
        local state=states[player]
        if state and living(player) and os.clock()-(state.returnAt or 0)>1 then
            state.returnAt=os.clock();Motion.Stop(player)
            player.Character:PivotTo(camp.Arrival.CFrame*CFrame.new(0,3,0))
        end
    end)
    camp.ToolShop.Upgrade.Interact.Triggered:Connect(function(player)
        local root=living(player)
        if root and (root.Position-camp.ToolShop.Upgrade.Position).Magnitude<15 then wire.OpenPanel:FireClient(player,"Shop") end
    end)
    for _,entrance in camp.MineEntrances:GetChildren() do
        if entrance:IsA("BasePart") and entrance:FindFirstChild("ChooseMine") then
            entrance.ChooseMine.Triggered:Connect(function(player)
                local root=living(player)
                if root and (root.Position-entrance.Position).Magnitude<15 then action(player,"Route",entrance:GetAttribute("RouteIndex")) end
            end)
        end
    end
    local elapsed,boardTime=0,0
    Run.Heartbeat:Connect(function(dt)
        elapsed+=dt
        boardTime+=dt
        if boardTime>=2 then boardTime=0;updateBoards() end
        if elapsed<.05 then return end
        local delta=elapsed;elapsed=0;step(delta)
    end)
end
return Service
]]></ProtectedString>
					<string name="ScriptGuid">{D8052504-5F55-4819-9CEA-2499179F3613}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MiningService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="ASSET000005">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Inventory = require(script.Parent.InventoryService)
local Feedback = game:GetService("ReplicatedStorage").DigCamp.Feedback

local SellZones = {}
local connection
local elapsed = 0

function SellZones.Contains(zone, root)
    local p = zone.CFrame:PointToObjectSpace(root.Position)
    local half = zone.Size * .5
    return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y and math.abs(p.Z) <= half.Z
end

function SellZones.Step()
    local zones = CollectionService:GetTagged("OreSellZone")
    for _, player in Players:GetPlayers() do
        if Inventory.Count(player) == 0 then continue end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then continue end
        for _, zone in zones do
            if not zone:IsA("BasePart") or not zone:IsDescendantOf(workspace) then continue end
            if zone:GetAttribute("Enabled") == false then continue end
            if not SellZones.Contains(zone, root) then continue end
            local receipt = Inventory.SellAll(player)
            if receipt then
                Feedback:FireClient(player, "sale", receipt.Total, receipt.Count)
                zone:SetAttribute("LastSaleCount", receipt.Count)
                zone:SetAttribute("LastSaleTotal", receipt.Total)
            end
            break
        end
    end
end

function SellZones.Start()
    if connection then return end
    connection = RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < .15 then return end
        elapsed = 0
        SellZones.Step()
    end)
end

return SellZones
]]></ProtectedString>
					<string name="ScriptGuid">{E25098F9-DD9F-44FD-B7A2-99723F4D8651}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">SellZoneService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff70000190d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX2511DA93C03C433B85F8028EBA9DAD84">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Style = require(game.ReplicatedStorage.Shared.MiningStyle)
local Motion = {}
local scopes = {}

function Motion.Stop(player)
    local scope = scopes[player]
    if not scope then return end
    scopes[player] = nil
    if scope.character.Parent then
        scope.character:SetAttribute("MiningStrokeAt", nil)
        scope.character:SetAttribute("MiningStrokeSpeed", nil)
    end
    if scope.humanoid.Parent then scope.humanoid.AutoRotate = scope.autoRotate end
end

function Motion.Play(player, target, speed)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or humanoid.Health <= 0 then return end
    local old = scopes[player]
    local autoRotate = old and old.character == character and old.autoRotate or humanoid.AutoRotate
    if old and old.character ~= character then Motion.Stop(player) end
    local scope = {character = character, humanoid = humanoid, autoRotate = autoRotate}
    scopes[player] = scope
    if target and target:IsA("BasePart") then
        local goal = Vector3.new(target.Position.X, root.Position.Y, target.Position.Z)
        if (goal - root.Position).Magnitude > .2 then root.CFrame = CFrame.lookAt(root.Position, goal) end
    end
    humanoid.AutoRotate = false
    speed = speed or 1
    character:SetAttribute("MiningStrokeSpeed", speed)
    character:SetAttribute("MiningStrokeAt", workspace:GetServerTimeNow())
    task.delay(Style.StrokeDuration / speed, function()
        if scopes[player] == scope then Motion.Stop(player) end
    end)
end

Players.PlayerRemoving:Connect(Motion.Stop)
return Motion
]]></ProtectedString>
					<string name="ScriptGuid">{897321E0-60D1-493C-AE5A-9D000B9A54BD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MiningMotion</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff7000029af</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12C04B80F26C462E80148B816916E6D8">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local assets = game:GetService("ServerStorage"):WaitForChild("GameAssets")
local Style = require(game.ReplicatedStorage.Shared.MiningStyle)
local Config = require(game.ReplicatedStorage.Shared.PrototypeConfig)
local Factory = {}

function Factory.GetEquipped(character)
    if not character then return nil end
    for _, child in character:GetChildren() do
        if child:IsA("Tool") and child:GetAttribute("AssetId") == "Tool.IronPickaxe" then
            return child
        end
    end
    return nil
end

function Factory.Equip(player, character, humanoid, backpack)
    if player.Character ~= character then return nil end
    local current = Factory.GetEquipped(character)
    if current then return current end
    local tool = assets.Tools.IronPickaxe:Clone()
    tool.Name = "铁镐"
    tool.Grip = Style.Grip
    for _, part in tool:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.Massless = true
            part.CanCollide = false
        end
    end
    tool.Parent = backpack
    humanoid:EquipTool(tool)
    return tool
end

function Factory.CreateRockVisual(parent, placement, options)
    options = options or {}
    local visual = assets.Ores.SandstoneOre:Clone()
    visual.Name = "RockVisual"
    if options.Scale then visual:ScaleTo(options.Scale) end
    if options.Stretch then
        local pivot = visual:GetPivot()
        for _, part in visual:GetDescendants() do
            if part:IsA("BasePart") and part~=visual.PrimaryPart then
                local localCF=pivot:ToObjectSpace(part.CFrame)
                part.Size=part.Size*options.Stretch
                part.CFrame=pivot*CFrame.new(localCF.Position*options.Stretch)*localCF.Rotation
            end
        end
    end
    for _, part in visual:GetDescendants() do
        if not part:IsA("MeshPart") then continue end
        local base = part:GetAttribute("BaseColor") or part.Color
        if part:GetAttribute("MeshRole") == "Inclusions" and options.MineralColor then
            local reference = Color3.fromRGB(198, 121, 67)
            local tint = options.MineralColor
            part.Color = Color3.new(math.min(1, base.R / reference.R * tint.R), math.min(1, base.G / reference.G * tint.G), math.min(1, base.B / reference.B * tint.B))
        elseif options.StoneTint then
            local tint = options.StoneTint
            local shade = math.clamp(math.max(base.R,base.G,base.B)/.86,.68,1.12)
            part.Color = Color3.new(math.min(1,tint.R*shade),math.min(1,tint.G*shade),math.min(1,tint.B*shade))
        end
    end
    visual:PivotTo(placement)
    visual.Parent = parent
    return visual
end

function Factory.CreateTrainingRockVisual(parent, placement, profile)
    local library = assets:FindFirstChild("TrainingRocks")
    local template = library and library:FindFirstChild(profile.PracticeAsset)
    assert(template and template:IsA("Model"), "Missing practice rock asset: " .. tostring(profile.PracticeAsset))
    local visual = template:Clone()
    visual.Name = "RockVisual"
    visual:ScaleTo(profile.PracticeScale or 1)
    visual:PivotTo(placement)
    for _, part in visual:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
        end
    end
    visual:SetAttribute("RestPivot", visual:GetPivot())
    visual:SetAttribute("PracticeAsset", profile.PracticeAsset)
    visual.Parent = parent
    return visual
end

local function replaceTrainingRock(model, target, index, profile)
    local oldOffset = target:GetAttribute("RockBaseOffset") or 2.2
    local ground = (target.CFrame * CFrame.new(0, -oldOffset, 0)).Position
    local placement = CFrame.new(ground) * CFrame.Angles(0, profile.PracticeYaw or -math.pi / 2, 0)
    local visual = Factory.CreateTrainingRockVisual(model, placement, profile)
    local bounds, size = visual:GetBoundingBox()
    target.CFrame = bounds
    target.Size = size
    target.Shape = Enum.PartType.Block
    target.Transparency = 1
    target.Anchored = true
    target.CanCollide = false
    target.CanTouch = false
    target.CanQuery = true
    target.Color = profile.StoneColor
    target:SetAttribute("RockBaseOffset", size.Y / 2)
    target:SetAttribute("TargetKind", "Training")
    target:SetAttribute("TrainingIndex", index)
    target:SetAttribute("ImpactColor", profile.Color)
    target:SetAttribute("LargeImpact", true)
    target:AddTag("TrainingTarget")
    -- Collision stays still while the visible stone shakes on the client.
    -- A single convex hull follows the actual stone outline, not a large box.
    local collider = visual.PrimaryPart:Clone()
    for _, child in collider:GetChildren() do child:Destroy() end
    collider.Name = "RockCollider"
    collider.Transparency = 1
    collider.TextureID = ""
    collider.CastShadow = false
    collider.Anchored = true
    collider.CanCollide = true
    collider.CanTouch = false
    collider.CanQuery = false
    collider.CollisionFidelity = Enum.CollisionFidelity.Hull
    collider.Parent = model
    local label = model:FindFirstChild("Training label")
    if label and label:IsA("BasePart") then
        label.CFrame = CFrame.new(ground + Vector3.new(0, size.Y + 2.3, 0))
        local text = label:FindFirstChildWhichIsA("TextLabel", true)
        if text then
            text.Text = profile.Name .. "\n+" .. profile.Gain .. " 力量 / 次" .. (profile.Required > 0 and (" · 需 " .. profile.Required) or "")
            text.TextColor3 = profile.Color:Lerp(Color3.new(1, 1, 1), .6)
        end
    end
    return visual
end

function Factory.ReplaceRock(model, index, isTraining, color)
    local target = model:FindFirstChild("Target")
    if not target then return end
    for _, child in model:GetChildren() do
        local oldGeometry = child:IsA("BasePart") and not child:FindFirstChildOfClass("BillboardGui")
        if child ~= target and (oldGeometry or child.Name == "RockVisual") then
            child:Destroy()
        end
    end
    local profile=isTraining and Config.Trainings[index] or nil
    if profile and profile.PracticeAsset then
        return replaceTrainingRock(model, target, index, profile)
    end
    local scale=profile and profile.Scale or .95
    local height=profile and profile.Height or 3.9*scale
    local rotation=profile and ({0,.42,-.35})[index] or index*.5
    local oldOffset=target:GetAttribute("RockBaseOffset") or 2.2
    local ground=target.CFrame*CFrame.new(0,-oldOffset,0)
    local visual=Factory.CreateRockVisual(model,ground*CFrame.Angles(0,rotation,0),{
        Scale=scale,Stretch=profile and profile.Stretch,
        MineralColor=profile and profile.Color or color,
        StoneTint=profile and profile.StoneColor or color,
    })
    if profile and profile.Crown then
        local crown=assets.Props.OreSamples[profile.Crown]:Clone()
        crown.Name="MineralCrown"
        crown:ScaleTo(index==2 and 3.2 or 3.8)
        for _,part in crown:GetDescendants()do
            if part:IsA("BasePart")then
                part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
                if part.Transparency<1 then part.Color=profile.Color:Lerp(Color3.new(1,1,1),part.Name:find("tip") and .28 or 0) end
            end
        end
        crown:PivotTo(visual:GetPivot()*CFrame.new(.3,index==2 and 6.5 or 6.3,0)*CFrame.Angles(0,0,index==2 and -.10 or .12))
        crown.Parent=visual
    end
    visual:SetAttribute("RestPivot",visual:GetPivot())
    target.CFrame=ground*CFrame.new(0,height/2,0)
    target:SetAttribute("RockBaseOffset",height/2)
    target:SetAttribute("ImpactColor",profile and profile.Color or color)
    target:SetAttribute("LargeImpact",isTraining)
    target.Color=profile and profile.StoneColor or color
    target.Transparency = 1
    target.Shape = Enum.PartType.Block
    target.Size = Vector3.new(5.4*scale*(profile and profile.Stretch.X or 1),height,4.0*scale)
    target.CanQuery = true
    if isTraining then
        target:SetAttribute("TargetKind", "Training")
        target:SetAttribute("TrainingIndex", index)
        target:AddTag("TrainingTarget")
    end
end

return Factory
]]></ProtectedString>
					<string name="ScriptGuid">{F93F268F-6E64-4A5C-BFC3-730C572470B8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">788c2288bf3e1ea10b09fff7000029b1</UniqueId>
					<string name="Name">MiningAssets</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">788c2288bf3e1ea10b09fff700005197</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXEF3BF7DCD842440BA65DA31BBB74888D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local assets = game:GetService("ServerStorage"):WaitForChild("GameAssets")
local Visuals = {}

-- One editable prefab supplies the gradient, double border and sparse stars.
function Visuals.Create(parent, name, placement, options)
    options = options or {}
    local zone = assets.Interactions.AutoSellZone:Clone()
    zone.Name = name
    zone:PivotTo(CFrame.identity)
    if options.Scale then zone:ScaleTo(options.Scale) end
    local trigger = zone.Trigger
    trigger:RemoveTag("OreSellZone")
    trigger:SetAttribute("Enabled", options.Sell == true)
    if options.Sell then trigger:AddTag("OreSellZone") end
    if options.Tag then trigger:AddTag(options.Tag) end
    for key, value in options.Attributes or {} do trigger:SetAttribute(key,value) end
    if zone:FindFirstChild("FloorLabel") then
        zone.FloorLabel.Lettering.Title.Text = options.Label or ""
    end
    if options.Color then
        for _, object in zone:GetDescendants() do
            if object:IsA("UIGradient") then
                object.Color = ColorSequence.new(options.Color:Lerp(Color3.new(1,1,1),.45),options.Color)
            elseif object:IsA("BasePart") and object.Material == Enum.Material.Neon then
                object.Color = options.Color
            elseif object:IsA("ParticleEmitter") then
                object.Color = ColorSequence.new(options.Color:Lerp(Color3.new(1,1,1),.65))
            end
        end
    end
    zone:PivotTo(placement)
    zone.Parent = parent
    return zone
end

return Visuals
]]></ProtectedString>
					<string name="ScriptGuid">{A583DF4A-A981-4940-A53A-D5B97E5A8E6E}</string>
